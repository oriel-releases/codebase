rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The website reads the latest version of each app from here; nothing else is public.
    match /application/{app} {
      allow get: if app in ['windows', 'linux', 'android', 'macos'];
    }

    // One document per account, keyed by Firebase uid. Only its owner can touch it.
    match /users/{uid} {
      allow get: if request.auth.uid == uid;
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      // birthday: optional "YYYY-MM-DD", set on the website's account page (/me); the apps and the extension show the
      // age it makes. A plausible year only (5 to 120 years ago).
      allow update: if request.auth.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt', 'birthday'])
        && request.resource.data.email == request.auth.token.email
        && (!('birthday' in request.resource.data)
          || (request.resource.data.birthday is string
            && request.resource.data.birthday.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && int(request.resource.data.birthday[0:4]) >= request.time.year() - 120
            && int(request.resource.data.birthday[0:4]) <= request.time.year() - 5));

      // Favorites, the same on every device: one document per photo, never deleted (favorite: false un-stars it, so that
      // syncs too). Each device asks only for the ones changed since its last sync (updatedAt).
      match /favorites/{photoId} {
        allow read: if request.auth.uid == uid;
        allow create, update: if request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['photoId', 'imageUrl', 'pageUrl', 'photographer', 'photographerUrl',
              'description', 'favorite', 'updatedAt', 'device'])
          && request.resource.data.photoId == photoId
          && request.resource.data.imageUrl is string
          && validImage(request.resource.data.imageUrl)
          && request.resource.data.favorite is bool
          && request.resource.data.updatedAt is timestamp;
      }

      // One document per signed-in app, extension or device. The app deletes its own on sign-out;
      // a missing document means that sign-in was revoked.
      match /sessions/{sessionId} {
        allow read, create, update, delete: if request.auth.uid == uid;
      }

      // What each device shows or does, shared between the account's devices.
      // sync/current: the wallpaper any of the account's devices (desktop, Android, the extension) set last; the others
      // show it too (they hear about it through the Realtime Database's pulse/{uid}, see database.rules.json).
      // sync/settings: the settings every device shares (schedule, time zone, interests, filters); last write wins.
      // sync/slot: which device claimed the latest scheduled change ("first device wins"), so only one picks a photo.
      // sync/extension: the browser extension's own settings and new tab shortcuts, the same in every browser of the account.
      match /sync/{doc} {
        // A follower (see followers below) may read just the current wallpaper.
        allow read: if request.auth.uid == uid
          || (doc == 'current' && exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)));
        allow create, update: if request.auth.uid == uid
          && ((doc == 'current' && validCurrent(request.resource.data))
            || (doc == 'settings' && validSyncedSettings(request.resource.data))
            || (doc == 'slot' && validSlot(request.resource.data))
            || (doc == 'extension' && validExtension(request.resource.data)));
      }
    }

    // Following a friend. The owner shares a code (codes/{code} names them); whoever knows it can add themselves as a
    // follower, which lets them read the owner's sync/current (above). The owner sees and removes followers; a follower
    // can leave. Codes can be looked up one at a time, never listed.
    match /users/{uid}/followers/{follower} {
      allow get, delete: if request.auth.uid == uid || request.auth.uid == follower;
      allow list: if request.auth.uid == uid;
      allow create, update: if request.auth.uid == follower
        && follower != uid
        && request.resource.data.keys().hasOnly(['code', 'name', 'createdAt'])
        && request.resource.data.code is string
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid;
    }

    // A follow code also carries what its page (/follow/{code}) shows a signed-in visitor: the owner's first name and
    // Google picture, and their current wallpaper, which the owner's app updates as it changes.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.uid == request.auth.uid
        && validCode(request.resource.data);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validCode(request.resource.data);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // A shared wallpaper (/share/{id}): the photo, and the sender's first name and Google picture. Signed-in visitors
    // look one up by its ID; nobody can list them. Never changed; the sender may delete it.
    match /shares/{id} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && id.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'from', 'picture', 'photoId', 'photoPath', 'photographer', 'photographerHandle', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'photoId', 'photoPath', 'createdAt'])
        && request.resource.data.from is string && request.resource.data.from.size() <= 30
        && validPicture(request.resource.data.picture)
        && validPhoto(request.resource.data)
        && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // A wallpaper's picture: an Unsplash photo, or an AI wallpaper made on a desktop (the Create page), which Pollinations
    // keeps at media.pollinations.ai/{id}.
    function validImage(url) {
      return url.matches('https://images[.]unsplash[.]com/.*') || url.matches('https://media[.]pollinations[.]ai/[0-9a-f]{16,128}');
    }

    function validCurrent(d) {
      return d.keys().hasAll(['photoId', 'imageUrl', 'source', 'updatedAt'])
        && d.keys().hasOnly(['photoId', 'imageUrl', 'pageUrl', 'photographer', 'photographerUrl', 'description', 'topic',
            'color', 'source', 'updatedAt'])
        && d.photoId is string
        && d.imageUrl is string
        && validImage(d.imageUrl)
        && d.source in ['windows', 'linux', 'android', 'extension', 'macos']
        && d.updatedAt is timestamp;
    }

    // The settings shared by every device of an account. Device-only ones (lock screen, fit, hotkey...) never come here.
    function validSyncedSettings(d) {
      return d.keys().hasOnly(['dailyTime', 'timeZone', 'intervalMinutes', 'paused', 'favoritesOnly', 'skipLowLikes',
            'minLikes', 'matchTimeOfDay', 'interests', 'updatedAt', 'device'])
        && (!('matchTimeOfDay' in d) || d.matchTimeOfDay is bool)
        && d.dailyTime is string && d.dailyTime.matches('[0-2][0-9]:[0-5][0-9]')
        && d.timeZone is string && d.timeZone.size() <= 64
        && d.intervalMinutes is int && d.intervalMinutes >= 0 && d.intervalMinutes <= 1440
        && d.paused is bool && d.favoritesOnly is bool && d.skipLowLikes is bool
        && d.minLikes is int && d.minLikes >= 0 && d.minLikes <= 100000
        && d.interests is list && d.interests.size() <= 200
        && d.updatedAt is timestamp
        && d.device is string && d.device.size() <= 64;
    }

    // A claimed scheduled change: its moment ("2026-10-14T09:00" in the shared time zone) and the device that took it.
    function validSlot(d) {
      return d.keys().hasOnly(['slotId', 'device', 'at'])
        && d.slotId is string && d.slotId.size() <= 32
        && d.device is string && d.device.size() <= 64
        && d.at is timestamp;
    }

    // The extension's settings (a small map) and shortcuts ([{title, url}], in order), written whole: last write wins.
    function validExtension(d) {
      return d.keys().hasOnly(['settings', 'shortcuts', 'updatedAt', 'device'])
        && d.settings is map && d.settings.size() <= 40
        && d.shortcuts is list && d.shortcuts.size() <= 14
        && d.updatedAt is timestamp
        && d.device is string && d.device.size() <= 64;
    }

    function validCode(d) {
      return d.keys().hasOnly(['uid', 'name', 'picture', 'createdAt', 'photoId', 'photoPath', 'photographer', 'photographerHandle'])
        && d.name is string && d.name.size() <= 30
        && (!('picture' in d) || validPicture(d.picture))
        && (!('photoId' in d) || validPhoto(d));
    }

    // Only a Google profile picture (or none): the pages load it, so no other address may be stored.
    function validPicture(p) {
      return p is string && p.size() <= 400 && (p == '' || p.matches('https://lh3[.]googleusercontent[.]com/.*'));
    }

    // An Unsplash photo: its ID and image path (the pages load it from images.unsplash.com), and the photographer.
    function validPhoto(d) {
      return d.photoId is string && d.photoId.matches('[A-Za-z0-9_-]{6,24}')
        && d.photoPath is string && d.photoPath.matches('[A-Za-z0-9_-]{6,120}')
        && d.photographer is string && d.photographer.size() <= 80
        && d.photographerHandle is string && d.photographerHandle.matches('[A-Za-z0-9_.-]{0,40}');
    }

    // Anonymous daily counts from the apps: one document per UTC day, numbers only, no user IDs. A signed-in app may
    // only add 1 to known counters, on today's document (give or take a day for clocks). Nobody can read them here;
    // they are read in the Firebase console.
    match /stats/{day} {
      allow create: if request.auth != null && isToday(day)
        && request.resource.data.keys().hasOnly(statKeys())
        && request.resource.data.keys().size() <= 5
        && startsAtOne('windows_new') && startsAtOne('linux_new') && startsAtOne('windows_active') && startsAtOne('linux_active')
        && startsAtOne('macos_new') && startsAtOne('macos_active')
        && startsAtOne('retained7') && startsAtOne('retained30')
        && startsAtOne('sharesSent') && startsAtOne('sharesOpened') && startsAtOne('sharesSet');
      allow update: if request.auth != null && isToday(day)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(statKeys())
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 5
        && plusOne('windows_new') && plusOne('linux_new') && plusOne('windows_active') && plusOne('linux_active')
        && plusOne('macos_new') && plusOne('macos_active')
        && plusOne('retained7') && plusOne('retained30')
        && plusOne('sharesSent') && plusOne('sharesOpened') && plusOne('sharesSet');

      function statKeys() {
        return ['windows_new', 'linux_new', 'macos_new', 'windows_active', 'linux_active', 'macos_active', 'retained7', 'retained30',
                'sharesSent', 'sharesOpened', 'sharesSet'];
      }
      function isToday(day) {
        return day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
          && math.abs(request.time.toMillis()
               - timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])).toMillis()) <= 2 * 86400000;
      }
      function startsAtOne(k) {
        return !(k in request.resource.data) || request.resource.data[k] == 1;
      }
      function plusOne(k) {
        return !(k in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data[k] == resource.data.get(k, 0) + 1;
      }
    }

    // The admin site (admin.oriel.akbarjon.uz) reads everything, writes nothing. Only the owner's Google sign-in passes:
    // the site's code is no secret, this check is what keeps everyone else out.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'akbarjonjorayev001@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Also covers collection group queries (every account's sessions at once) for the admin.
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
