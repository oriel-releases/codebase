# Public URL of the site (canonical links, sitemap, Open Graph, structured data).
# Production builds default to https://oriel.akbarjon.uz; set this to use another domain.
SITE_URL=https://oriel.akbarjon.uz

# Where the installers are downloaded from. They default to the newest GitHub release:
# https://github.com/oriel-releases/windows/releases/latest/download/Oriel-Setup.exe
# https://github.com/oriel-releases/linux/releases/latest/download/Oriel.AppImage
ORIEL_DOWNLOAD_URL=
ORIEL_LINUX_DOWNLOAD_URL=
