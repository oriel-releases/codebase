{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/download", "destination": "/download.html" },
      { "source": "/login", "destination": "/login.html" },
      { "source": "/me", "destination": "/me.html" }
    ]
  }
}
