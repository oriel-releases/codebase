<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oriel.UI.Controls.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  One row of a settings group, like the Friends list: icon tile, title, a line under it, the control.  -->
    <Grid>
        <!--  The line between rows, from where the text starts; the group's first row has none.  -->
        <Rectangle
            Height="1"
            Margin="62,0,16,0"
            VerticalAlignment="Top"
            Fill="{ThemeResource OrielLineBrush}"
            Visibility="{x:Bind DividerVisibility(First), Mode=OneWay}" />
        <Grid
            MinHeight="56"
            Padding="16,10"
            ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                Background="{ThemeResource OrielPaperBrush}"
                CornerRadius="{StaticResource OrielTileRadius}">
                <FontIcon FontSize="14" Glyph="{x:Bind Glyph, Mode=OneWay}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind Header, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource OrielMutedBrush}"
                    Text="{x:Bind Description, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind VisibleIfAny(Description), Mode=OneWay}" />
            </StackPanel>
            <ContentPresenter
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="{x:Bind Action, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
