<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oriel.UI.Controls.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        MinHeight="64"
        Padding="20,14,16,14"
        Background="{ThemeResource OrielSurfaceBrush}"
        ColumnSpacing="16"
        CornerRadius="{StaticResource OrielCardRadius}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FontIcon
            VerticalAlignment="Center"
            FontSize="18"
            Foreground="{ThemeResource OrielMutedBrush}"
            Glyph="{x:Bind Glyph, Mode=OneWay}" />
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock Text="{x:Bind Header, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource OrielMutedBrush}"
                Text="{x:Bind Description, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind VisibleIfAny(Description), Mode=OneWay}" />
        </StackPanel>
        <ContentPresenter
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Content="{x:Bind Action, Mode=OneWay}" />
    </Grid>
</UserControl>
