<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oriel.UI.Controls.SignInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel
            MaxWidth="360"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <Image
                Width="56"
                Height="56"
                HorizontalAlignment="Center"
                Source="{ThemeResource OrielLogoImage}" />
            <TextBlock
                Margin="0,12,0,8"
                HorizontalAlignment="Center"
                Style="{StaticResource PageTitleStyle}"
                Text="Sign in to Oriel" />

            <InfoBar
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <!--  White with dark text in both themes, like Google's own button.  -->
            <Button
                Height="44"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Continue with Google"
                Background="#F2F2F2"
                BorderThickness="0"
                Command="{x:Bind ViewModel.OpenBrowserCommand}"
                CornerRadius="22"
                Foreground="#141414"
                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E4E4E4" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D8D8D8" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#141414" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#141414" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#141414" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <!--  Decoded at 2x the display size so it stays sharp when scaled down.  -->
                    <Image Width="18" Height="18">
                        <Image.Source>
                            <BitmapImage DecodePixelHeight="36" DecodePixelWidth="36" UriSource="ms-appx:///Assets/GoogleG.png" />
                        </Image.Source>
                    </Image>
                    <TextBlock FontWeight="Medium" Text="{x:Bind ViewModel.ButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <!--  Accounts made with an email and password: the website opens with its email form ready.  -->
            <HyperlinkButton
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.OpenEmailCommand}"
                Content="Use email and password instead"
                FontSize="13"
                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />

            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource MutedTextStyle}"
                Text="Waiting for you to finish in the browser…"
                Visibility="{x:Bind ViewModel.IsWaiting, Mode=OneWay}" />

            <HyperlinkButton
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                AutomationProperties.Name="Contact support on Telegram"
                Command="{x:Bind ViewModel.OpenSupportCommand}"
                FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="13" Glyph="&#xE8F2;" />
                    <TextBlock Text="Need help? Message support on Telegram" />
                </StackPanel>
            </HyperlinkButton>
        </StackPanel>
    </Grid>
</UserControl>
