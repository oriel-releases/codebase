<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oriel.UI.Controls.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oriel.UI"
    xmlns:vm="using:Oriel.UI.ViewModels">

    <UserControl.Resources>
        <!--  Every button in the tour is this tall, so the ones side by side always line up  -->
        <x:Double x:Key="TourButtonHeight">40</x:Double>

        <!--  A small round icon tile before a line of text  -->
        <Style x:Key="TourIconTile" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{ThemeResource OrielSurfaceBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer SizeChanged="Scroller_SizeChanged" VerticalScrollBarVisibility="Auto">
        <!--  Its width is set from the window (see SizeChanged): at most 640, always centered  -->
        <Grid
            x:Name="Column"
            MinHeight="560"
            Margin="0,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RowSpacing="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ Header: the progress line (it fills as you go) and Skip ============  -->
            <!--  One row: 1/3, the line, Skip setup  -->
            <Grid MinHeight="32" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.StepText, Mode=OneWay}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.StepShort, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowProgress, Mode=OneWay}" />
                <Grid
                    Grid.Column="1"
                    Height="4"
                    VerticalAlignment="Center"
                    Background="{ThemeResource OrielLineBrush}"
                    CornerRadius="2"
                    Visibility="{x:Bind ViewModel.ShowProgress, Mode=OneWay}">
                    <Border
                        Background="{ThemeResource OrielInkBrush}"
                        CornerRadius="2"
                        RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressFill" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <HyperlinkButton
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.SkipCommand}"
                    Content="Skip setup"
                    Foreground="{ThemeResource OrielMutedBrush}"
                    Visibility="{x:Bind ViewModel.ShowSkip, Mode=OneWay}" />
            </Grid>

            <!--  ============ Steps (each slides in) ============  -->
            <Grid Grid.Row="1" VerticalAlignment="Center">

                <!--  0: Welcome  -->
                <StackPanel
                    x:Name="Step0"
                    Spacing="26"
                    Visibility="{x:Bind ViewModel.IsWelcome, Mode=OneWay}">
                    <!--  Three photos, the kind Oriel brings  -->
                    <Grid Height="168" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Margin="0,18,0,0"
                            Background="{ThemeResource OrielSurfaceBrush}"
                            CornerRadius="{StaticResource OrielCardRadius}">
                            <Image
                                local:ImageReveal.Enabled="True"
                                Source="{x:Bind ViewModel.Hero1}"
                                Stretch="UniformToFill" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource OrielSurfaceBrush}"
                            CornerRadius="{StaticResource OrielCardRadius}">
                            <Image
                                local:ImageReveal.Enabled="True"
                                Source="{x:Bind ViewModel.Hero2}"
                                Stretch="UniformToFill" />
                        </Border>
                        <Border
                            Grid.Column="2"
                            Margin="0,18,0,0"
                            Background="{ThemeResource OrielSurfaceBrush}"
                            CornerRadius="{StaticResource OrielCardRadius}">
                            <Image
                                local:ImageReveal.Enabled="True"
                                Source="{x:Bind ViewModel.Hero3}"
                                Stretch="UniformToFill" />
                        </Border>
                    </Grid>

                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image
                                Width="36"
                                Height="36"
                                Source="{ThemeResource OrielLogoImage}" />
                            <TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource PageTitleStyle}"
                                Text="Welcome to Oriel" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="A beautiful new wallpaper, picked for you. Setting up takes under a minute." />
                    </StackPanel>

                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TourIconTile}">
                                <FontIcon FontSize="16" Glyph="&#xE787;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="A new photo, on your schedule" />
                                <TextBlock
                                    FontSize="13"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="Every day or every few hours, or whenever you press Change now." />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TourIconTile}">
                                <FontIcon FontSize="16" Glyph="&#xEB51;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="Only what you love" />
                                <TextBlock
                                    FontSize="13"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="You pick the interests. Star a favorite to keep it forever." />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TourIconTile}">
                                <FontIcon FontSize="16" Glyph="&#xE708;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="Quiet and light" />
                                <TextBlock
                                    FontSize="13"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="Oriel waits in the tray and only wakes up to change your wallpaper." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!--  1: Interests, as photo tiles  -->
                <StackPanel
                    x:Name="Step1"
                    Spacing="18"
                    Visibility="{x:Bind ViewModel.IsInterests, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Margin="0"
                            Style="{StaticResource PageTitleStyle}"
                            Text="What do you like?" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Pick a few. Each new wallpaper comes from one of them." />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Interests}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="10"
                                MinItemHeight="92"
                                MinItemWidth="140"
                                MinRowSpacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:InterestChip">
                                <Grid
                                    Height="92"
                                    Background="#1C1C1C"
                                    CornerRadius="14"
                                    RequestedTheme="Dark">
                                    <!--  Same as the Interests page: nothing flashes on hover or press, the photo zooms instead  -->
                                    <Button
                                        AutomationProperties.Name="{x:Bind Label}"
                                        Command="{x:Bind ToggleCommand}"
                                        CornerRadius="14"
                                        PointerCanceled="Tile_PointerExited"
                                        PointerEntered="Tile_PointerEntered"
                                        PointerExited="Tile_PointerExited"
                                        Style="{StaticResource PhotoTileButtonStyle}">
                                        <Grid>
                                            <Grid>
                                                <Grid.ScaleTransition>
                                                    <Vector3Transition Duration="0:0:0.3" />
                                                </Grid.ScaleTransition>
                                                <Image
                                                    local:ImageReveal.Enabled="True"
                                                    Source="{x:Bind Cover}"
                                                    Stretch="UniformToFill" />
                                            </Grid>
                                            <Border Background="{StaticResource OrielPhotoScrimBrush}" />
                                            <TextBlock
                                                Margin="12,0,12,10"
                                                VerticalAlignment="Bottom"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{x:Bind Label}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Border
                                                Width="22"
                                                Height="22"
                                                Margin="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="White"
                                                CornerRadius="11"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay}">
                                                <FontIcon
                                                    FontSize="11"
                                                    Foreground="#141414"
                                                    Glyph="&#xE73E;" />
                                            </Border>
                                            <Border
                                                Width="22"
                                                Height="22"
                                                Margin="8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="#33000000"
                                                BorderBrush="#CCFFFFFF"
                                                BorderThickness="1.5"
                                                CornerRadius="11"
                                                Visibility="{x:Bind IsNotSelected, Mode=OneWay}" />
                                        </Grid>
                                    </Button>
                                    <Border
                                        BorderBrush="White"
                                        BorderThickness="2"
                                        CornerRadius="14"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Style="{StaticResource MutedTextStyle}"
                            Text="{x:Bind ViewModel.InterestsHint, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            Height="32"
                            Command="{x:Bind ViewModel.SelectAllInterestsCommand}"
                            Content="Select all"
                            Style="{StaticResource PillButtonStyle}">
                            <Button.CommandParameter>
                                <x:Boolean>True</x:Boolean>
                            </Button.CommandParameter>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Height="32"
                            Command="{x:Bind ViewModel.SelectAllInterestsCommand}"
                            Content="Clear"
                            Style="{StaticResource PillButtonStyle}">
                            <Button.CommandParameter>
                                <x:Boolean>False</x:Boolean>
                            </Button.CommandParameter>
                        </Button>
                    </Grid>
                </StackPanel>

                <!--  2: How often, as cards  -->
                <StackPanel
                    x:Name="Step2"
                    Spacing="18"
                    Visibility="{x:Bind ViewModel.IsSchedule, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Margin="0"
                            Style="{StaticResource PageTitleStyle}"
                            Text="How often should it change?" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Most people like one new photo a day. You can change this any time." />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Schedules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScheduleChoice">
                                <!--
                                    A card: the choice on top; "Once a day", chosen, opens a row with the time below it.
                                    The button has the card's own color, never Transparent: WinUI fades the hover color in,
                                    and from Transparent (which is transparent white) that fade flashes pale for a moment.
                                -->
                                <Grid Background="{ThemeResource OrielSurfaceBrush}" CornerRadius="{StaticResource OrielCardRadius}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        Padding="18,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind Label}"
                                        Background="{ThemeResource OrielSurfaceBrush}"
                                        Command="{x:Bind SelectCommand}"
                                        CornerRadius="{StaticResource OrielCardRadius}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Label}" />
                                                <TextBlock
                                                    FontSize="13"
                                                    Style="{StaticResource MutedTextStyle}"
                                                    Text="{x:Bind Description}" />
                                            </StackPanel>
                                            <!--  A radio mark: a filled disc with a check when chosen, an empty ring otherwise  -->
                                            <Border
                                                Grid.Column="1"
                                                Width="22"
                                                Height="22"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource OrielInkBrush}"
                                                CornerRadius="11"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay}">
                                                <FontIcon
                                                    FontSize="11"
                                                    Foreground="{ThemeResource OrielPaperBrush}"
                                                    Glyph="&#xE73E;" />
                                            </Border>
                                            <Border
                                                Grid.Column="1"
                                                Width="22"
                                                Height="22"
                                                VerticalAlignment="Center"
                                                BorderBrush="{ThemeResource OrielMutedBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="11"
                                                Visibility="{x:Bind IsNotSelected, Mode=OneWay}" />
                                        </Grid>
                                    </Button>
                                    <Grid
                                        Grid.Row="1"
                                        Margin="18,0,18,14"
                                        ColumnSpacing="12"
                                        Visibility="{x:Bind ShowsTime, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Foreground="{ThemeResource OrielMutedBrush}"
                                            Glyph="&#xE823;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="Every day at" />
                                        <TimePicker
                                            Grid.Column="2"
                                            MinWidth="0"
                                            AutomationProperties.Name="Daily change time"
                                            CornerRadius="{StaticResource OrielPillRadius}"
                                            Loaded="DailyTime_Loaded"
                                            MinuteIncrement="5" />
                                    </Grid>
                                    <Border
                                        Grid.RowSpan="2"
                                        BorderBrush="{ThemeResource OrielInkBrush}"
                                        BorderThickness="2"
                                        CornerRadius="{StaticResource OrielCardRadius}"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <!--  3: Preferences  -->
                <StackPanel
                    x:Name="Step3"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.IsPreferences, Mode=OneWay}">
                    <StackPanel Margin="0,0,0,8" Spacing="6">
                        <TextBlock
                            Margin="0"
                            Style="{StaticResource PageTitleStyle}"
                            Text="Make it yours" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="A few choices about how Oriel behaves. All can be changed later in Settings." />
                    </StackPanel>

                    <Grid
                        Padding="18,14"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        ColumnSpacing="14"
                        CornerRadius="{StaticResource OrielCardRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource OrielPaperBrush}" Style="{StaticResource TourIconTile}">
                            <FontIcon FontSize="16" Glyph="&#xE790;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Match the Windows accent color" />
                            <TextBlock
                                FontSize="13"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Start, taskbar and buttons take a color from each new photo." />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            AutomationProperties.Name="Match the Windows accent color"
                            IsOn="{x:Bind ViewModel.MatchAccentColor, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Grid
                        Padding="18,14"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        ColumnSpacing="14"
                        CornerRadius="{StaticResource OrielCardRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource OrielPaperBrush}" Style="{StaticResource TourIconTile}">
                            <FontIcon FontSize="16" Glyph="&#xE72E;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Use it on the lock screen too" />
                            <TextBlock
                                FontSize="13"
                                Style="{StaticResource MutedTextStyle}"
                                Text="The same photo greets you before you sign in." />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            AutomationProperties.Name="Use it on the lock screen too"
                            IsOn="{x:Bind ViewModel.ChangeLockScreen, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Grid
                        Padding="18,14"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        ColumnSpacing="14"
                        CornerRadius="{StaticResource OrielCardRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource OrielPaperBrush}" Style="{StaticResource TourIconTile}">
                            <FontIcon FontSize="16" Glyph="&#xE7E8;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Start with Windows" />
                            <TextBlock
                                FontSize="13"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Oriel waits quietly in the tray so your schedule keeps running." />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            AutomationProperties.Name="Start with Windows"
                            IsOn="{x:Bind ViewModel.RunInBackground, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </StackPanel>

                <!--  4: Done  -->
                <StackPanel
                    x:Name="Step4"
                    Spacing="22"
                    Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource OrielInkBrush}"
                        CornerRadius="32">
                        <FontIcon
                            FontSize="26"
                            Foreground="{ThemeResource OrielPaperBrush}"
                            Glyph="&#xE73E;" />
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock
                            Margin="0"
                            Style="{StaticResource PageTitleStyle}"
                            Text="You're all set" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Here's what Oriel will do. Let's find your first wallpaper." />
                    </StackPanel>

                    <StackPanel
                        Padding="18,6"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        CornerRadius="{StaticResource OrielCardRadius}">
                        <Grid Padding="0,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="15"
                                Foreground="{ThemeResource OrielMutedBrush}"
                                Glyph="&#xEB51;" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Interests" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind ViewModel.SummaryInterests, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource OrielLineBrush}" />
                        <Grid Padding="0,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="15"
                                Foreground="{ThemeResource OrielMutedBrush}"
                                Glyph="&#xE823;" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource MutedTextStyle}"
                                Text="New photo" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.SummarySchedule, Mode=OneWay}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource OrielLineBrush}" />
                        <Grid Padding="0,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                FontSize="15"
                                Foreground="{ThemeResource OrielMutedBrush}"
                                Glyph="&#xE7F4;" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Applied to" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind ViewModel.SummaryLook, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        FontSize="13"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{x:Bind ViewModel.Tip}" />
                </StackPanel>
            </Grid>

            <!--  ============ Footer: Back on the left, the way forward on the right, all the same height ============  -->
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Height="{StaticResource TourButtonHeight}"
                    MinWidth="96"
                    Command="{x:Bind ViewModel.BackCommand}"
                    Style="{StaticResource PillButtonStyle}"
                    Visibility="{x:Bind ViewModel.ShowBack, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                        <TextBlock Text="Back" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Height="{StaticResource TourButtonHeight}"
                        MinWidth="140"
                        Command="{x:Bind ViewModel.NextCommand}"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Visibility="{x:Bind ViewModel.ShowNext, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.NextText, Mode=OneWay}" />
                            <FontIcon FontSize="12" Glyph="&#xE72A;" />
                        </StackPanel>
                    </Button>
                    <Button
                        Height="{StaticResource TourButtonHeight}"
                        Command="{x:Bind ViewModel.FinishCommand}"
                        Content="Just take me in"
                        Style="{StaticResource PillButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}">
                        <Button.CommandParameter>
                            <x:Boolean>False</x:Boolean>
                        </Button.CommandParameter>
                    </Button>
                    <Button
                        Height="{StaticResource TourButtonHeight}"
                        Command="{x:Bind ViewModel.FinishCommand}"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsDone, Mode=OneWay}">
                        <Button.CommandParameter>
                            <x:Boolean>True</x:Boolean>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="{x:Bind ViewModel.FirstWallpaperText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
