<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oriel.UI.Controls.PositionEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Over the whole window: the photo, whole, with this screen's shape over it (PositionEditorView.xaml.cs).  -->
    <Grid
        x:Name="Root"
        Padding="32,20,32,28"
        Background="{ThemeResource OrielPaperBrush}"
        KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Position" />
            <Button
                HorizontalAlignment="Right"
                AutomationProperties.Name="Close"
                Click="Close_Click"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Close (Esc)">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <Grid
            x:Name="Stage"
            Grid.Row="1"
            Margin="0,20"
            SizeChanged="Stage_SizeChanged">
            <Canvas
                x:Name="Board"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                PointerCanceled="Board_PointerReleased"
                PointerMoved="Board_PointerMoved"
                PointerPressed="Board_PointerPressed"
                PointerReleased="Board_PointerReleased"
                Visibility="Collapsed">
                <Image x:Name="Whole" Source="{x:Bind ViewModel.Whole, Mode=OneWay}" Stretch="Fill" />
                <!--  The rest of the photo, dimmed around the window.  -->
                <Path Fill="#99000000">
                    <Path.Data>
                        <GeometryGroup FillRule="EvenOdd">
                            <RectangleGeometry x:Name="DimAll" />
                            <RectangleGeometry x:Name="DimHole" />
                        </GeometryGroup>
                    </Path.Data>
                </Path>
                <!--  The window: this screen's shape, with the thirds while dragging.  -->
                <Border
                    x:Name="WindowFrame"
                    BorderBrush="White"
                    BorderThickness="2">
                    <Grid x:Name="Thirds" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.RowSpan="3" Width="1" HorizontalAlignment="Right" Fill="#73FFFFFF" />
                        <Rectangle Grid.Column="1" Grid.RowSpan="3" Width="1" HorizontalAlignment="Right" Fill="#73FFFFFF" />
                        <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="#73FFFFFF" />
                        <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="#73FFFFFF" />
                    </Grid>
                </Border>
            </Canvas>
            <ProgressRing
                x:Name="Loading"
                Width="32"
                Height="32"
                IsActive="True" />
            <TextBlock
                x:Name="ErrorText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource MutedTextStyle}"
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Grid>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Spacing="16">
            <!--  Smart, Center, or where you put it: the same switch as History's, its pill sliding over.  -->
            <Grid
                IsHitTestVisible="{x:Bind ViewModel.CanEditNow, Mode=OneWay}"
                HorizontalAlignment="Center"
                Padding="3"
                Background="{ThemeResource OrielSurfaceBrush}"
                BorderBrush="{ThemeResource OrielLineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OrielPillRadius}">
                <Border
                    x:Name="ModeIndicator"
                    Background="{ThemeResource OrielInkBrush}"
                    CornerRadius="{StaticResource OrielPillRadius}" />
                <StackPanel x:Name="ModeStrip" Orientation="Horizontal">
                    <RadioButton
                        Width="96"
                        Content="Smart"
                        GroupName="PositionMode"
                        IsChecked="{x:Bind ViewModel.IsSmart, Mode=TwoWay}"
                        Style="{StaticResource PillTabStyle}"
                        ToolTipService.ToolTip="Unsplash finds the faces or the detail" />
                    <RadioButton
                        Width="96"
                        Content="Center"
                        GroupName="PositionMode"
                        IsChecked="{x:Bind ViewModel.IsCenter, Mode=TwoWay}"
                        Style="{StaticResource PillTabStyle}" />
                    <RadioButton
                        Width="96"
                        Content="Custom"
                        GroupName="PositionMode"
                        IsChecked="{x:Bind ViewModel.IsCustom, Mode=TwoWay}"
                        Style="{StaticResource PillTabStyle}"
                        ToolTipService.ToolTip="Drag the frame, or click where it goes" />
                </StackPanel>
            </Grid>
            <Button
                MinWidth="200"
                HorizontalAlignment="Center"
                Click="Set_Click"
                IsEnabled="{x:Bind ViewModel.CanEditNow, Mode=OneWay}"
                Style="{StaticResource PrimaryPillButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
