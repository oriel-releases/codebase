<?xml version="1.0" encoding="utf-8" ?>
<!--  Buttons and links that sit on top of a photo: frosted-white circles, white icons and text.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ButtonBackground" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#E0E0E0" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#C0C0C0" />
</ResourceDictionary>
