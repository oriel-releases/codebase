<?xml version="1.0" encoding="utf-8" ?>
<!--  Oriel light palette. Referenced from App.xaml's ThemeDictionaries so it can override the stock WinUI colors.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="OrielPaper">#FAFAFA</Color>
    <Color x:Key="OrielSurface">#F1F1F1</Color>
    <Color x:Key="OrielLine">#E4E4E4</Color>
    <Color x:Key="OrielMuted">#6B6B6B</Color>
    <Color x:Key="OrielInk">#141414</Color>
    <Color x:Key="OrielInkHover">#363636</Color>
    <SolidColorBrush x:Key="OrielPaperBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="OrielSurfaceBrush" Color="#F1F1F1" />
    <SolidColorBrush x:Key="OrielLineBrush" Color="#E4E4E4" />
    <SolidColorBrush x:Key="OrielMutedBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="OrielInkBrush" Color="#141414" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#141414" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#363636" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#363636" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#141414" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#141414" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#F1F1F1" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E4E4E4" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E4E4E4" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#F1F1F1" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#E4E4E4" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#E4E4E4" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F1F1F1" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F1F1F1" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
    <BitmapImage x:Key="OrielLogoImage" UriSource="ms-appx:///Assets/Logo.png" />
</ResourceDictionary>
