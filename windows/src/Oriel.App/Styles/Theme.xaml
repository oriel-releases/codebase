<?xml version="1.0" encoding="utf-8" ?>
<!--
    Oriel's look, shared with the website: ink on paper, softly rounded, no borders.
    Overrides WinUI's accent and card resources so every stock control follows it.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--
        Buttons, inputs, chips and tabs are pills. Surfaces (cards, bars, the preview) are
        rounded to scale: bigger things get bigger radii, and nested shapes use outer radius
        minus padding so corners stay concentric.
    -->
    <CornerRadius x:Key="OrielPillRadius">12</CornerRadius>
    <!--  Icon buttons are circles: half their 36px size  -->
    <CornerRadius x:Key="OrielIconRadius">18</CornerRadius>
    <!--  Tab inside the 3px-padded tab strip: strip radius minus padding, so the corners are concentric  -->
    <CornerRadius x:Key="OrielTabItemRadius">9</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="OrielMediumRadius">12</CornerRadius>
    <CornerRadius x:Key="OrielCardRadius">16</CornerRadius>
    <CornerRadius x:Key="OrielLargeRadius">20</CornerRadius>
    <!--  Photo thumbnails, and the one-line search bar (half its 52px height)  -->
    <CornerRadius x:Key="OrielThumbRadius">8</CornerRadius>
    <!--  The small icon tile at the start of a row (Settings, Friends, Interests) and Home's today thumbnail.  -->
    <CornerRadius x:Key="OrielTileRadius">10</CornerRadius>
    <CornerRadius x:Key="OrielBarRadius">26</CornerRadius>
    <!--  Dark fade at the bottom of a photo card: keeps white text and buttons readable on any picture  -->
    <LinearGradientBrush x:Key="OrielPhotoScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="0.45" Color="#59000000" />
        <GradientStop Offset="1" Color="#CC000000" />
    </LinearGradientBrush>
    <!--  The favorite star  -->
    <SolidColorBrush x:Key="OrielStarBrush" Color="#F5B301" />

    <!--  Plain buttons: soft surface, no outline  -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource OrielSurface}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource OrielLine}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource OrielLine}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="{ThemeResource OrielSurface}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource OrielLine}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource OrielLine}" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />

    <!--  Cards (Settings rows, expanders): surface, no border  -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource OrielSurface}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{ThemeResource OrielSurface}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />

    <!--  Layout  -->
    <x:Double x:Key="PageMaxWidth">960</x:Double>
    <x:Double x:Key="OrielRowSpacing">6</x:Double>
    <Thickness x:Key="PageContentMargin">40,8,40,40</Thickness>

    <!--  Text  -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Margin" Value="0,24,0,4" />
    </Style>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource OrielMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,28,0,8" />
    </Style>
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource OrielMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Buttons  -->
    <!--
        No border: ours are invisible anyway, and Windows draws a button's background inside its border, so a 1px
        transparent border made plain buttons look 2px smaller than accent ones beside them at the same height.
    -->
    <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource OrielPillRadius}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="PrimaryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource OrielPillRadius}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource OrielIconRadius}" />
    </Style>
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource OrielIconRadius}" />
    </Style>
    <Style x:Key="ChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource OrielPillRadius}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style x:Key="PillTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource OrielPillRadius}" />
        <Setter Property="Padding" Value="14,6,10,6" />
    </Style>

    <!--
        Photo tiles (Interests, the tour): a button with nothing but its content. No hover or press states, so the
        photo never flashes; the page zooms the photo on hover instead. Still a real button for keyboard and screen readers.
    -->
    <Style x:Key="PhotoTileButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="{TemplateBinding Background}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Every stock button and input is a pill by default  -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource OrielPillRadius}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource OrielPillRadius}" />
        <Setter Property="Padding" Value="16,7" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource OrielPillRadius}" />
        <Setter Property="Padding" Value="14,6,10,6" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource OrielPillRadius}" />
        <Setter Property="Padding" Value="14,5,0,7" />
    </Style>

    <!--  Navigation tabs in the title bar: muted text, ink pill when selected  -->
    <Style x:Key="PillTabStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{ThemeResource OrielMutedBrush}" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!--  Transparent, not empty: the whole option takes the click, not only its icon and word.  -->
                    <Grid Background="Transparent" CornerRadius="{StaticResource OrielTabItemRadius}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OrielPaperBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
