<?xml version="1.0" encoding="utf-8" ?>
<!--  Oriel dark palette. Referenced from App.xaml's ThemeDictionaries so it can override the stock WinUI colors.  -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="OrielPaper">#0F0F0F</Color>
    <Color x:Key="OrielSurface">#1A1A1A</Color>
    <Color x:Key="OrielLine">#262626</Color>
    <Color x:Key="OrielMuted">#9A9A9A</Color>
    <Color x:Key="OrielInk">#F2F2F2</Color>
    <Color x:Key="OrielInkHover">#D6D6D6</Color>
    <SolidColorBrush x:Key="OrielPaperBrush" Color="#0F0F0F" />
    <SolidColorBrush x:Key="OrielSurfaceBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="OrielLineBrush" Color="#262626" />
    <SolidColorBrush x:Key="OrielMutedBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="OrielInkBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0F0F0F" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#0F0F0F" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#262626" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#262626" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#262626" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#262626" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
    <BitmapImage x:Key="OrielLogoImage" UriSource="ms-appx:///Assets/Logo-Dark.png" />
</ResourceDictionary>
