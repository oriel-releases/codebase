<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Oriel.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Oriel.UI.Controls"
    Title="Oriel">

    <!--  No background here: the window's Mica backdrop shows through, like the Settings app.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Oriel (Beta)">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="{ThemeResource OrielLogoImage}" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  Left pane like the Windows Settings app; Settings sits at the bottom of the pane.  -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="240"
            IsPaneOpen="False"
            PaneDisplayMode="Left"
            ItemInvoked="Nav_ItemInvoked"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                <!--  The pane and page share the window's paper colour; no card or border around the page.  -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource OrielSurface}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource OrielLine}" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource OrielSurface}" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource OrielInk}" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Home"
                    IsSelected="True"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI" Tag="create">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M12.67,0.67L11.83,2.5L10,3.33L11.83,4.17L12.67,6L13.5,4.17L15.33,3.33L13.5,2.5M6,2.67L4.33,6.33L0.67,8L4.33,9.67L6,13.33L7.67,9.67L11.33,8L7.67,6.33M12.67,10L11.83,11.83L10,12.67L11.83,13.5L12.67,15.33L13.5,13.5L15.33,12.67L13.5,11.83" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Friends" Tag="friends">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame
                x:Name="ContentFrame"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </NavigationView>

        <!--  Covers the app until the account is signed in.  -->
        <controls:SignInView x:Name="SignIn" Grid.Row="1" Visibility="Collapsed" />

        <!--  The first-run tour: shown once after the first sign-in.  -->
        <controls:OnboardingView x:Name="Onboarding" Grid.Row="1" Visibility="Collapsed" />

        <!--  A photo a friend shared with a link: one button sets it as the wallpaper.  -->
        <controls:SharedPhotoView x:Name="Shared" Grid.Row="1" Visibility="Collapsed" />

        <!--  Signing out: nothing can be clicked until it's done.  -->
        <Grid
            x:Name="SigningOut"
            Grid.RowSpan="2"
            Background="{ThemeResource OrielPaperBrush}"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <ProgressRing
                    x:Name="SigningOutRing"
                    Width="32"
                    Height="32"
                    IsActive="False" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource MutedTextStyle}"
                    Text="Signing out…" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
