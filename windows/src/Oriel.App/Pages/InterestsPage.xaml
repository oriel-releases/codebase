<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.InterestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oriel.UI"
    xmlns:vm="using:Oriel.UI.ViewModels">

    <Page.Resources>
        <!--  One interest: its photo, its name, and a check when it's on. A click turns it on or off.  -->
        <DataTemplate x:Key="InterestTile" x:DataType="vm:TopicViewModel">
            <Grid
                Height="136"
                Background="#1C1C1C"
                CornerRadius="{StaticResource OrielCardRadius}"
                RequestedTheme="Dark">
                <!--  Nothing flashes on hover or press; the photo zooms instead  -->
                <Button
                    AutomationProperties.Name="{x:Bind Label}"
                    Command="{x:Bind ToggleCommand}"
                    CornerRadius="{StaticResource OrielCardRadius}"
                    PointerCanceled="Tile_PointerExited"
                    PointerEntered="Tile_PointerEntered"
                    PointerExited="Tile_PointerExited"
                    Style="{StaticResource PhotoTileButtonStyle}">
                    <Grid>
                        <!--  The photo eases in like everywhere else; hovering zooms it a little (the wrapper scales, so the two never fight)  -->
                        <Grid>
                            <Grid.ScaleTransition>
                                <Vector3Transition Duration="0:0:0.3" />
                            </Grid.ScaleTransition>
                            <!--  Until the photo is there: the Oriel mark (and, for your own, what's happening)  -->
                            <StackPanel
                                Margin="0,0,0,26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6">
                                <Image
                                    Width="30"
                                    Height="30"
                                    Opacity="0.35"
                                    Source="ms-appx:///Assets/Logo-Dark.png" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#99FFFFFF"
                                    Text="{x:Bind CoverNote, Mode=OneWay}"
                                    Visibility="{x:Bind HasNoCover, Mode=OneWay}" />
                            </StackPanel>
                            <Image
                                local:ImageReveal.Enabled="True"
                                Source="{x:Bind Cover, Mode=OneWay}"
                                Stretch="UniformToFill"
                                ToolTipService.ToolTip="{x:Bind CoverCredit}" />
                        </Grid>
                        <Border Background="{StaticResource OrielPhotoScrimBrush}" />
                        <TextBlock
                            Margin="14,0,14,12"
                            VerticalAlignment="Bottom"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{x:Bind Label}"
                            TextTrimming="CharacterEllipsis" />
                        <!--  On: a white disc with a check. Off: an empty ring.  -->
                        <Border
                            Width="24"
                            Height="24"
                            Margin="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="White"
                            CornerRadius="12"
                            Visibility="{x:Bind IsEnabled, Mode=OneWay}">
                            <FontIcon
                                FontSize="12"
                                Foreground="#141414"
                                Glyph="&#xE73E;" />
                        </Border>
                        <Border
                            Width="24"
                            Height="24"
                            Margin="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#33000000"
                            BorderBrush="#CCFFFFFF"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Visibility="{x:Bind IsOff, Mode=OneWay}" />
                    </Grid>
                </Button>
                <Border
                    BorderBrush="White"
                    BorderThickness="2"
                    CornerRadius="{StaticResource OrielCardRadius}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsEnabled, Mode=OneWay}" />
                <!--  Your own ones can be removed  -->
                <Button
                    Width="28"
                    Height="28"
                    Margin="8"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Remove this interest"
                    Background="#66000000"
                    Command="{x:Bind RemoveCommand}"
                    CornerRadius="14"
                    ToolTipService.ToolTip="Remove"
                    Visibility="{x:Bind IsCustom}">
                    <FontIcon
                        FontSize="10"
                        Foreground="White"
                        Glyph="&#xE711;" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Margin="40,32,40,40"
            Spacing="20">

            <!--  Back, title, what's on, and the quick actions  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back to search"
                    Click="Back_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Back">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0"
                        Style="{StaticResource PageTitleStyle}"
                        Text="Interests" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.MixSummary, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        Command="{x:Bind ViewModel.SelectAllCommand}"
                        Content="Select all"
                        Style="{StaticResource PillButtonStyle}">
                        <Button.CommandParameter>
                            <x:Boolean>True</x:Boolean>
                        </Button.CommandParameter>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.SelectAllCommand}"
                        Content="Clear"
                        Style="{StaticResource PillButtonStyle}">
                        <Button.CommandParameter>
                            <x:Boolean>False</x:Boolean>
                        </Button.CommandParameter>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.NothingEnabled, Mode=OneWay}"
                Message="Nothing is on, so Oriel uses general landscape photos."
                Severity="Warning" />

            <ItemsRepeater ItemTemplate="{StaticResource InterestTile}" ItemsSource="{x:Bind ViewModel.BuiltInTopics}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemHeight="136"
                        MinItemWidth="190"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!--  Your own: added from Search (search first, then Add to Interests)  -->
            <StackPanel Margin="0,8,0,0" Spacing="12">
                <TextBlock
                    Margin="2,0,0,0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Your own" />
                <TextBlock
                    Margin="2,0,0,0"
                    Style="{StaticResource MutedTextStyle}"
                    Text="Search for anything, then press Add to Interests to make it one of yours." />
                <ItemsRepeater
                    ItemTemplate="{StaticResource InterestTile}"
                    ItemsSource="{x:Bind ViewModel.CustomTopics}"
                    Visibility="{x:Bind ViewModel.HasCustomTopics, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="12"
                            MinItemHeight="136"
                            MinItemWidth="190"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
