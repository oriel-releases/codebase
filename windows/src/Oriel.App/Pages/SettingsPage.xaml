<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Oriel.UI.Controls">

    <ScrollViewer>
        <Grid>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Margin="{StaticResource PageContentMargin}"
            Spacing="{StaticResource OrielRowSpacing}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />

            <!--  ============ Account ============  -->
            <TextBlock Margin="2,4,0,8" Style="{StaticResource SectionHeaderStyle}" Text="Account" />
            <Grid
                MinHeight="64"
                Padding="20,12,16,12"
                Background="{ThemeResource OrielSurfaceBrush}"
                ColumnSpacing="16"
                CornerRadius="{StaticResource OrielCardRadius}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Oriel's logo, covered by the Google photo once that loads (so a failed photo just shows the logo).  -->
                <Grid
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center">
                    <Border Background="{ThemeResource OrielPaperBrush}" CornerRadius="20">
                        <Image
                            Width="22"
                            Height="22"
                            Source="{ThemeResource OrielLogoImage}" />
                    </Border>
                    <Ellipse x:Name="PhotoEllipse" Visibility="Collapsed">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.AccountName}" TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource OrielMutedBrush}"
                        Text="{x:Bind ViewModel.AccountEmail}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Sign out"
                    Command="{x:Bind ViewModel.SignOutCommand}"
                    Content="Sign out" />
            </Grid>

            <!--  ============ Schedule ============  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Schedule" />
            <controls:SettingRow
                Description="Once a day, or as a slideshow that keeps changing through the day."
                Glyph="&#xE8B3;"
                Header="Change wallpaper">
                <ComboBox
                    MinWidth="150"
                    AutomationProperties.Name="Change wallpaper"
                    ItemsSource="{x:Bind ViewModel.IntervalOptions}"
                    SelectedIndex="{x:Bind ViewModel.IntervalIndex, Mode=TwoWay}" />
            </controls:SettingRow>
            <controls:SettingRow
                Description="Favorites cycles through the photos you starred in History. With none, new photos are used."
                Glyph="&#xE8B9;"
                Header="Pick from">
                <ComboBox
                    MinWidth="150"
                    AutomationProperties.Name="Pick from"
                    ItemsSource="{x:Bind ViewModel.SourceOptions}"
                    SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}" />
            </controls:SettingRow>
            <controls:SettingRow
                Description="A new wallpaper once a day at this time."
                Glyph="&#xE823;"
                Header="Daily change time"
                Visibility="{x:Bind ViewModel.IsDaily, Mode=OneWay}">
                <!--  Wired in code-behind: a TwoWay binding on TimePicker pushes 00:00 back on load.  -->
                <TimePicker
                    x:Name="DailyTimePicker"
                    MinWidth="0"
                    AutomationProperties.Name="Daily change time"
                    CornerRadius="{StaticResource OrielPillRadius}"
                    MinuteIncrement="5" />
            </controls:SettingRow>
            <controls:SettingRow
                Description="If today's wallpaper isn't set yet when you sign in, change it right away."
                Glyph="&#xE77B;"
                Header="Change at sign-in"
                Visibility="{x:Bind ViewModel.IsDaily, Mode=OneWay}">
                <ToggleSwitch
                    MinWidth="0"
                    AutomationProperties.Name="Change at sign-in"
                    IsOn="{x:Bind ViewModel.ApplyAtLogin, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </controls:SettingRow>

            <controls:SettingRow
                Description="{x:Bind ViewModel.ShortcutNote, Mode=OneWay}"
                Glyph="&#xE765;"
                Header="Next wallpaper shortcut">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        Width="170"
                        AutomationProperties.Name="Next wallpaper shortcut"
                        IsReadOnly="True"
                        KeyDown="Shortcut_KeyDown"
                        PlaceholderText="Click, then press keys"
                        Text="{x:Bind ViewModel.Shortcut, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Remove shortcut"
                        Command="{x:Bind ViewModel.ClearShortcutCommand}"
                        Content="Clear" />
                </StackPanel>
            </controls:SettingRow>

            <!--  ============ Display ============  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Display" />
            <controls:SettingRow
                Description="How the photo fits your screen. Span stretches one photo across all monitors."
                Glyph="&#xE740;"
                Header="Fit">
                <ComboBox
                    MinWidth="110"
                    AutomationProperties.Name="Fit"
                    ItemsSource="{x:Bind ViewModel.FitModes}"
                    SelectedIndex="{x:Bind ViewModel.FitIndex, Mode=TwoWay}" />
            </controls:SettingRow>

            <controls:SettingRow
                Description="Choose whether each new wallpaper also becomes your lock screen picture."
                Glyph="&#xE72E;"
                Header="Apply to">
                <ComboBox
                    MinWidth="190"
                    AutomationProperties.Name="Apply to"
                    ItemsSource="{x:Bind ViewModel.ApplyToOptions}"
                    SelectedIndex="{x:Bind ViewModel.ApplyToIndex, Mode=TwoWay}" />
            </controls:SettingRow>

            <!--  ============ Quality ============  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Quality" />
            <controls:SettingRow
                Description="Prefer photos other people liked on Unsplash."
                Glyph="&#xE8E1;"
                Header="Skip photos with few likes">
                <ToggleSwitch
                    MinWidth="0"
                    AutomationProperties.Name="Skip photos with few likes"
                    IsOn="{x:Bind ViewModel.SkipLowLikes, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </controls:SettingRow>
            <controls:SettingRow
                Glyph="&#xE76E;"
                Header="Minimum likes"
                Visibility="{x:Bind ViewModel.SkipLowLikes, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider
                        Width="200"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Minimum likes"
                        Maximum="1000"
                        Minimum="0"
                        SmallChange="10"
                        StepFrequency="10"
                        Value="{x:Bind ViewModel.MinLikes, Mode=TwoWay}" />
                    <TextBlock
                        MinWidth="36"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.MinLikes, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingRow>

            <!--  ============ Storage ============  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Storage" />
            <InfoBar
                CornerRadius="{StaticResource OrielMediumRadius}"
                IsOpen="{x:Bind ViewModel.IsFolderInfoOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.FolderInfoMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.FolderInfoSeverity, Mode=OneWay}" />
            <controls:SettingRow
                Description="{x:Bind ViewModel.PicturesFolder, Mode=OneWay}"
                Glyph="&#xE838;"
                Header="Wallpaper folder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.OpenPicturesFolderCommand}" Content="Open" />
                    <Button Command="{x:Bind ViewModel.ChangeFolderCommand}" ToolTipService.ToolTip="Pick an empty folder; your photos move there.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{x:Bind ViewModel.IsMovingFolder, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsMovingFolder, Mode=OneWay}" />
                            <TextBlock Text="Change" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingRow>

            <!--  ============ App ============  -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="App" />
            <controls:SettingRow
                Description="Start minimized to the system tray when you sign in."
                Glyph="&#xE7E8;"
                Header="Start with Windows">
                <ToggleSwitch
                    MinWidth="0"
                    AutomationProperties.Name="Start with Windows"
                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </controls:SettingRow>
            <controls:SettingRow
                Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                Glyph="&#xE895;"
                Header="Updates">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressBar
                        Width="120"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Update download progress"
                        Maximum="100"
                        Value="{x:Bind ViewModel.UpdateProgress, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.UpdateCommand}"
                        Visibility="{x:Bind ViewModel.CanUpdate}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{x:Bind ViewModel.IsUpdateBusy, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsUpdateBusy, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingRow>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
