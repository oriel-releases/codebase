<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oriel.UI">

    <!--  A checked favorite keeps the soft grey button; only its star turns yellow (see Star).  -->
    <Page.Resources>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource OrielSurface}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource OrielLine}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource OrielLine}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource OrielInk}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource OrielInk}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource OrielInk}" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
    </Page.Resources>

    <ScrollViewer>
        <Grid>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Margin="{StaticResource PageContentMargin}"
            Spacing="16">

            <InfoBar
                Title="{x:Bind ViewModel.InfoTitle, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.IsInfoOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}" />

            <!--  Today's wallpaper. Click it twice (and keep clicking) to favorite it: stars burst up (HomePage.xaml.cs).  -->
            <Grid
                PointerPressed="Preview_PointerPressed"
                Height="440"
                Background="{ThemeResource OrielSurfaceBrush}"
                CornerRadius="{StaticResource OrielLargeRadius}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasNoCurrent, Mode=OneWay}">
                    <Image
                        Width="48"
                        Height="48"
                        Opacity="0.25"
                        Source="{ThemeResource OrielLogoImage}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource MutedTextStyle}"
                        Text="No wallpaper yet. Press Change now." />
                </StackPanel>
                <Image
                    local:ImageReveal.Enabled="True"
                    AutomationProperties.Name="Current wallpaper"
                    Source="{x:Bind ViewModel.Preview, Mode=OneWay}"
                    Stretch="UniformToFill" />
                <Canvas x:Name="StarLayer" IsHitTestVisible="False" />
            </Grid>

            <!--  Credit (required by Unsplash guidelines) and actions  -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="2"
                    Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Photo by" />
                        <HyperlinkButton
                            Padding="5,2"
                            Content="{x:Bind ViewModel.PhotographerName, Mode=OneWay}"
                            FontWeight="SemiBold"
                            NavigateUri="{x:Bind ViewModel.PhotographerUri, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text="on" />
                        <HyperlinkButton
                            Padding="5,2"
                            Content="Unsplash"
                            FontWeight="SemiBold"
                            NavigateUri="{x:Bind ViewModel.PhotoPageUri, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        AutomationProperties.Name="Share this wallpaper"
                        Click="Share_Click"
                        IsEnabled="{x:Bind ViewModel.HasShareLink, Mode=OneWay}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Share this wallpaper. Whoever opens the link can set it in one click.">
                        <Grid>
                            <FontIcon FontSize="15" Glyph="&#xE72D;" Visibility="{x:Bind local:Star.Hidden(ViewModel.IsLinkCopied), Mode=OneWay}" />
                            <FontIcon FontSize="15" Glyph="&#xE73E;" Visibility="{x:Bind local:Star.Shown(ViewModel.IsLinkCopied), Mode=OneWay}" />
                        </Grid>
                    </Button>
                    <!--  Locked keeps this wallpaper (no automatic changes), unlocked lets it change.  -->
                    <ToggleButton
                        AutomationProperties.Name="Keep this wallpaper"
                        IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="Lock to keep this wallpaper. Unlock to let it change.">
                        <Grid>
                            <FontIcon FontSize="15" Glyph="&#xE785;" Visibility="{x:Bind local:Star.Hidden(ViewModel.IsPaused), Mode=OneWay}" />
                            <FontIcon FontSize="15" Glyph="&#xE72E;" Visibility="{x:Bind local:Star.Shown(ViewModel.IsPaused), Mode=OneWay}" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton
                        AutomationProperties.Name="Favorite"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasCurrent, Mode=OneWay}"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="Favorite: keep this one forever">
                        <Grid>
                            <FontIcon FontSize="15" Glyph="&#xE734;" Visibility="{x:Bind local:Star.Hidden(ViewModel.IsFavorite), Mode=OneWay}" />
                            <FontIcon FontSize="15" Foreground="{StaticResource OrielStarBrush}" Glyph="&#xE735;" Visibility="{x:Bind local:Star.Shown(ViewModel.IsFavorite), Mode=OneWay}" />
                        </Grid>
                    </ToggleButton>
                    <Button
                        Height="36"
                        AutomationProperties.Name="Change wallpaper now"
                        Command="{x:Bind ViewModel.ChangeNowCommand}"
                        IsEnabled="{x:Bind ViewModel.CanChange, Mode=OneWay}"
                        Style="{StaticResource PrimaryPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Glyph="&#xE72C;"
                                Visibility="{x:Bind ViewModel.ShowChangeIcon, Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Glyph="&#xE121;"
                                Visibility="{x:Bind ViewModel.ShowLimitIcon, Mode=OneWay}" />
                            <!--  The label slides when it changes ("Downloading…" → "Changing…"): HomePage.xaml.cs  -->
                            <TextBlock x:Name="ChangeText">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="ChangeTextShift" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Wallpaper of the day: the same photo as oriel.akbarjon.uz/today, one click away.  -->
            <Grid
                Margin="0,8,0,0"
                Padding="10,10,16,10"
                Background="{ThemeResource OrielSurfaceBrush}"
                ColumnSpacing="16"
                CornerRadius="{StaticResource OrielCardRadius}"
                Visibility="{x:Bind ViewModel.HasToday, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="128"
                    Height="80"
                    Background="{ThemeResource OrielLineBrush}"
                    CornerRadius="12">
                    <Image
                        local:ImageReveal.Enabled="True"
                        AutomationProperties.Name="Wallpaper of the day"
                        Source="{x:Bind ViewModel.TodayThumb, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="Wallpaper of the day" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Photo by" />
                        <HyperlinkButton
                            Padding="4,1"
                            Content="{x:Bind ViewModel.TodayBy, Mode=OneWay}"
                            FontSize="12"
                            NavigateUri="{x:Bind ViewModel.TodayAuthorUri, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Style="{StaticResource MutedTextStyle}"
                            Text="on Unsplash" />
                    </StackPanel>
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.SetTodayCommand}"
                    Content="{x:Bind ViewModel.TodayButtonText, Mode=OneWay}"
                    Style="{StaticResource PillButtonStyle}" />
            </Grid>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
