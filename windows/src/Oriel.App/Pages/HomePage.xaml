<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oriel.UI"
    xmlns:vm="using:Oriel.UI.ViewModels">

    <!--  A checked favorite keeps the soft grey button; only its star turns yellow (see Star).  -->
    <Page.Resources>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource OrielSurface}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource OrielLine}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource OrielLine}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource OrielInk}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource OrielInk}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource OrielInk}" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
        <!--  A color dot on Home: no box behind it; it grows a little under the pointer and dips when pressed.  -->
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Padding="{TemplateBinding Padding}" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Scale" Value="1.15,1.15,1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Presenter.Scale" Value="0.92,0.92,1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <!--  Grows and dips smoothly (it jumped before), around the middle of its 24px dot.  -->
                            <ContentPresenter x:Name="Presenter" CenterPoint="12,12,0">
                                <ContentPresenter.ScaleTransition>
                                    <Vector3Transition Duration="0:0:0.14" />
                                </ContentPresenter.ScaleTransition>
                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!--  A focus change never scrolls the page (opening the Wallpaper of the day could jump it to the top first).  -->
    <ScrollViewer BringIntoViewOnFocusChange="False">
        <Grid>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Margin="{StaticResource PageContentMargin}"
            Spacing="16">

            <InfoBar
                Title="{x:Bind ViewModel.InfoTitle, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.IsInfoOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}" />

            <!--  Today's wallpaper. Click it twice (and keep clicking) to favorite it: stars burst up (HomePage.xaml.cs).  -->
            <!--  The stars sit over the photo, not in its rounded clip, so they rise past its edge whole.  -->
            <Grid>
                <Grid
                    x:Name="PreviewBox"
                    PointerPressed="Preview_PointerPressed"
                    PointerEntered="Preview_PointerMoved"
                    PointerMoved="Preview_PointerMoved"
                    PointerExited="Preview_PointerExited"
                    Height="440"
                    Background="{ThemeResource OrielSurfaceBrush}"
                    CornerRadius="{StaticResource OrielLargeRadius}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasNoCurrent, Mode=OneWay}">
                        <Image
                            Width="48"
                            Height="48"
                            Opacity="0.25"
                            Source="{ThemeResource OrielLogoImage}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="No wallpaper yet. Press Change now." />
                    </StackPanel>
                    <Image
                        local:ImageReveal.Enabled="True"
                        AutomationProperties.Name="Current wallpaper"
                        Source="{x:Bind ViewModel.Preview, Mode=OneWay}"
                        Stretch="UniformToFill" />
                    <!--
                        The eyedropper (HomePage.xaml.cs): a magnifier on the spot under the pointer, its pixels large, the
                        picked ones boxed in the middle, its rim in their color.
                    -->
                    <Canvas IsHitTestVisible="False">
                        <Grid
                            x:Name="PickRing"
                            Width="108"
                            Height="108"
                            CenterPoint="54,54,0"
                            Opacity="0"
                            Scale="0.6,0.6,1">
                            <Grid.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </Grid.OpacityTransition>
                            <Grid.ScaleTransition>
                                <Vector3Transition Duration="0:0:0.2" />
                            </Grid.ScaleTransition>
                            <Ellipse Fill="#40000000" />
                            <Ellipse Margin="1" Fill="White" />
                            <Border
                                Width="99"
                                Height="99"
                                CornerRadius="50">
                                <Canvas x:Name="PickCells" Width="99" Height="99" />
                            </Border>
                            <Ellipse
                                x:Name="PickRingColor"
                                Margin="4"
                                StrokeThickness="6" />
                            <Rectangle
                                Width="29"
                                Height="29"
                                Stroke="#99000000"
                                StrokeThickness="1" />
                            <Rectangle
                                Width="27"
                                Height="27"
                                Stroke="White"
                                StrokeThickness="1.5" />
                        </Grid>
                    </Canvas>
                </Grid>
                <Canvas x:Name="StarLayer" IsHitTestVisible="False" />
            </Grid>

            <!--  Credit (required by Unsplash guidelines) and actions  -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="2"
                    Visibility="{x:Bind ViewModel.HasCurrent, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.CreditLead, Mode=OneWay}" />
                        <HyperlinkButton
                            Padding="5,2"
                            Content="{x:Bind ViewModel.PhotographerName, Mode=OneWay}"
                            FontWeight="SemiBold"
                            NavigateUri="{x:Bind ViewModel.PhotographerUri, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text="on" Visibility="{x:Bind ViewModel.IsPhoto, Mode=OneWay}" />
                        <HyperlinkButton
                            Padding="5,2"
                            Content="Unsplash"
                            FontWeight="SemiBold"
                            NavigateUri="{x:Bind ViewModel.PhotoPageUri, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsPhoto, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--  The photo's top three colors, in one pill like the buttons beside it: the ringed one is the accent, here and on the other devices.  -->
                    <Border
                        Height="36"
                        Margin="0,0,2,0"
                        Padding="5,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        CornerRadius="18"
                        Visibility="{x:Bind ViewModel.HasAccents, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <ItemsControl VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.Accents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccentSwatchViewModel">
                                        <Button
                                            AutomationProperties.Name="{x:Bind Tip}"
                                            Command="{x:Bind ChooseCommand}"
                                            Style="{StaticResource SwatchButtonStyle}"
                                            ToolTipService.ToolTip="Use as accent color">
                                            <Grid Width="24" Height="24">
                                                <!--  Its fade is added once it shows its first state (Ring_Loaded), so no ring flashes on.  -->
                                                <Ellipse
                                                    Loaded="Ring_Loaded"
                                                    Opacity="{x:Bind RingOpacity, Mode=OneWay}"
                                                    Stroke="{ThemeResource OrielInkBrush}"
                                                    StrokeThickness="1.75" />
                                                <Ellipse
                                                    Width="16"
                                                    Height="16"
                                                    Fill="{x:Bind Brush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!--  Custom: pick any color from the photo itself. Once picked, it fills the button like the others.  -->
                            <Button
                                x:Name="EyedropperButton"
                                AutomationProperties.Name="Pick a color from the photo"
                                Click="Eyedropper_Click"
                                Style="{StaticResource SwatchButtonStyle}"
                                ToolTipService.ToolTip="Pick the accent color from the photo">
                                <Grid Width="24" Height="24">
                                    <Ellipse
                                        Loaded="Ring_Loaded"
                                        Opacity="{x:Bind ViewModel.CustomRingOpacity, Mode=OneWay}"
                                        Stroke="{ThemeResource OrielInkBrush}"
                                        StrokeThickness="1.75" />
                                    <Ellipse
                                        Width="16"
                                        Height="16"
                                        Fill="{x:Bind ViewModel.CustomAccent, Mode=OneWay}" />
                                    <!--  Lucide "pipette": on its own, or small on the custom color, black or white to show on it.  -->
                                    <Viewbox
                                        Width="14"
                                        Height="14"
                                        Visibility="{x:Bind local:Star.Hidden(ViewModel.IsCustomChosen), Mode=OneWay}">
                                        <Path
                                            Width="24"
                                            Height="24"
                                            Data="M2,22 L3,21 H6 L15,12 M3,21 V18 L12,9 M15,6 L18.4,2.6 A2.1,2.1 0 1 1 21.4,5.6 L18,9 L18.4,9.4 A2.1,2.1 0 1 1 15.4,12.4 L11.6,8.6 A2.1,2.1 0 1 1 14.6,5.6 Z"
                                            Stroke="{ThemeResource OrielInkBrush}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Viewbox>
                                    <Viewbox
                                        Width="9"
                                        Height="9"
                                        Visibility="{x:Bind local:Star.Shown(ViewModel.IsCustomChosen), Mode=OneWay}">
                                        <Path
                                            Width="24"
                                            Height="24"
                                            Data="M2,22 L3,21 H6 L15,12 M3,21 V18 L12,9 M15,6 L18.4,2.6 A2.1,2.1 0 1 1 21.4,5.6 L18,9 L18.4,9.4 A2.1,2.1 0 1 1 15.4,12.4 L11.6,8.6 A2.1,2.1 0 1 1 14.6,5.6 Z"
                                            Stroke="{x:Bind ViewModel.CustomInk, Mode=OneWay}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                    </Viewbox>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button
                        AutomationProperties.Name="Share this wallpaper"
                        Click="Share_Click"
                        IsEnabled="{x:Bind ViewModel.HasShareLink, Mode=OneWay}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Share this wallpaper. Whoever opens the link can set it in one click.">
                        <Grid>
                            <FontIcon FontSize="15" Glyph="&#xE72D;" Visibility="{x:Bind local:Star.Hidden(ViewModel.IsLinkCopied), Mode=OneWay}" />
                            <FontIcon FontSize="15" Glyph="&#xE73E;" Visibility="{x:Bind local:Star.Shown(ViewModel.IsLinkCopied), Mode=OneWay}" />
                        </Grid>
                    </Button>
                    <!--  Locked keeps this wallpaper (no automatic changes), unlocked lets it change.  -->
                    <ToggleButton
                        AutomationProperties.Name="Keep this wallpaper"
                        IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="Lock to keep this wallpaper. Unlock to let it change.">
                        <Grid>
                            <FontIcon FontSize="15" Glyph="&#xE785;" Visibility="{x:Bind local:Star.Hidden(ViewModel.IsPaused), Mode=OneWay}" />
                            <FontIcon FontSize="15" Glyph="&#xE72E;" Visibility="{x:Bind local:Star.Shown(ViewModel.IsPaused), Mode=OneWay}" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton
                        AutomationProperties.Name="Favorite"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.HasCurrent, Mode=OneWay}"
                        Style="{StaticResource IconToggleButtonStyle}"
                        ToolTipService.ToolTip="Favorite: keep this one forever">
                        <Grid>
                            <FontIcon FontSize="15" Glyph="&#xE734;" Visibility="{x:Bind local:Star.Hidden(ViewModel.IsFavorite), Mode=OneWay}" />
                            <FontIcon FontSize="15" Foreground="{StaticResource OrielStarBrush}" Glyph="&#xE735;" Visibility="{x:Bind local:Star.Shown(ViewModel.IsFavorite), Mode=OneWay}" />
                        </Grid>
                    </ToggleButton>
                    <Button
                        Height="36"
                        AutomationProperties.Name="Change wallpaper now"
                        Command="{x:Bind ViewModel.ChangeNowCommand}"
                        IsEnabled="{x:Bind ViewModel.CanChange, Mode=OneWay}"
                        Style="{StaticResource PrimaryPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Glyph="&#xE72C;"
                                Visibility="{x:Bind ViewModel.ShowChangeIcon, Mode=OneWay}" />
                            <FontIcon
                                FontSize="14"
                                Glyph="&#xE121;"
                                Visibility="{x:Bind ViewModel.ShowLimitIcon, Mode=OneWay}" />
                            <!--  The label slides when it changes ("Downloading…" → "Changing…"): HomePage.xaml.cs  -->
                            <TextBlock x:Name="ChangeText">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="ChangeTextShift" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Wallpaper of the day: the same photo as oriel.akbarjon.uz/today. A compact row; a click opens its photo page.  -->
            <Grid
                MinHeight="56"
                Margin="0,8,0,0"
                Padding="10,8,14,8"
                Background="{ThemeResource OrielSurfaceBrush}"
                ColumnSpacing="14"
                CornerRadius="{StaticResource OrielLargeRadius}"
                PointerEntered="Today_PointerEntered"
                Tag="{x:Bind ViewModel.Today, Mode=OneWay}"
                Tapped="Today_Tapped"
                Visibility="{x:Bind ViewModel.HasToday, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="TodayThumb"
                    Width="64"
                    Height="40"
                    Background="{ThemeResource OrielLineBrush}"
                    CornerRadius="{StaticResource OrielTileRadius}">
                    <Image
                        local:ImageReveal.Enabled="True"
                        AutomationProperties.Name="Wallpaper of the day"
                        Source="{x:Bind ViewModel.TodayThumb, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="Wallpaper of the day" />
                    <TextBlock
                        FontSize="12"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{x:Bind ViewModel.TodayCaption, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <FontIcon
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource OrielMutedBrush}"
                    Glyph="&#xE76C;" />
            </Grid>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
