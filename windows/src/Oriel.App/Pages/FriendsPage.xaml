<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.FriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Oriel.UI.ViewModels">

    <Grid>
        <ScrollViewer>
            <StackPanel
                MaxWidth="{StaticResource PageMaxWidth}"
                Margin="{StaticResource PageContentMargin}"
                Spacing="16">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Friends" />

                <!--  Following someone: their wallpaper is the card. Always dark underneath, so the white text reads in both themes.  -->
                <Grid
                    Height="220"
                    Background="#1C1C1C"
                    CornerRadius="{StaticResource OrielLargeRadius}"
                    RequestedTheme="Dark"
                    Visibility="{x:Bind ViewModel.IsFollowing, Mode=OneWay}">
                    <Border
                        Width="80"
                        Height="80"
                        Margin="0,0,0,50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#33FFFFFF"
                        CornerRadius="40"
                        Visibility="{x:Bind ViewModel.HasNoFriendWallpaper, Mode=OneWay}">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="32"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{x:Bind ViewModel.FollowingInitial, Mode=OneWay}" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Bind ViewModel.FollowingPicture, Mode=OneWay}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <Image
                        Source="{x:Bind ViewModel.FriendWallpaper, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind ViewModel.HasFriendWallpaper, Mode=OneWay}" />
                    <Border Background="{StaticResource OrielPhotoScrimBrush}" Visibility="{x:Bind ViewModel.HasFriendWallpaper, Mode=OneWay}" />
                    <Grid
                        Padding="24,20"
                        VerticalAlignment="Bottom"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom" Spacing="2">
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{x:Bind ViewModel.FollowingTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="White"
                                Opacity="0.8"
                                Text="{x:Bind ViewModel.FriendWallpaperDetail, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Height="40"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.UnfollowCommand}"
                            Content="Unfollow"
                            Style="{StaticResource PillButtonStyle}" />
                    </Grid>
                </Grid>

                <!--  A friend's follow link is being followed right now  -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.IsLinkFollowing, Mode=OneWay}">
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind ViewModel.IsLinkFollowing, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Following your friend…" />
                </StackPanel>

                <!--  The three things to do, as one list  -->
                <StackPanel
                    Background="{ThemeResource OrielSurfaceBrush}"
                    CornerRadius="{StaticResource OrielLargeRadius}">
                    <Grid Padding="16,10" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="32"
                            Height="32"
                            Background="{ThemeResource OrielPaperBrush}"
                            CornerRadius="{StaticResource OrielTileRadius}">
                            <FontIcon FontSize="14" Glyph="&#xE72D;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Share my wallpaper" />
                            <TextBlock FontSize="12" Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.ShareDetail, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Height="32"
                                Command="{x:Bind ViewModel.TurnOffSharingCommand}"
                                Content="Turn off"
                                Style="{StaticResource PillButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsSharing, Mode=OneWay}" />
                            <Button
                                Height="32"
                                MinWidth="88"
                                Click="Share_Click"
                                Content="{x:Bind ViewModel.ShareText, Mode=OneWay}"
                                Style="{StaticResource PrimaryPillButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{x:Bind ViewModel.IsNotFollowing, Mode=OneWay}">
                        <Rectangle Height="1" Margin="62,0,16,0" VerticalAlignment="Top" Fill="{ThemeResource OrielLineBrush}" />
                        <Grid Padding="16,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="32"
                                Height="32"
                                Background="{ThemeResource OrielPaperBrush}"
                                CornerRadius="{StaticResource OrielTileRadius}">
                                <FontIcon FontSize="14" Glyph="&#xE8FA;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="Follow a friend" />
                                <TextBlock FontSize="12" Style="{StaticResource MutedTextStyle}" Text="Use a friend's wallpaper." />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Height="32"
                                MinWidth="88"
                                Click="EnterCode_Click"
                                Content="Enter code"
                                Style="{StaticResource PillButtonStyle}" />
                        </Grid>
                    </Grid>

                    <Grid Visibility="{x:Bind ViewModel.HasFollowers, Mode=OneWay}">
                        <Rectangle Height="1" Margin="62,0,16,0" VerticalAlignment="Top" Fill="{ThemeResource OrielLineBrush}" />
                        <Grid Padding="16,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="32"
                                Height="32"
                                Background="{ThemeResource OrielPaperBrush}"
                                CornerRadius="{StaticResource OrielTileRadius}">
                                <FontIcon FontSize="14" Glyph="&#xE716;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="Followers" />
                                <TextBlock FontSize="12" Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.FollowersDetail, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Height="32"
                                MinWidth="88"
                                Click="Followers_Click"
                                Content="See all"
                                Style="{StaticResource PillButtonStyle}" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <InfoBar
                    Closed="Message_Closed"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                    Severity="Warning" />
            </StackPanel>
        </ScrollViewer>

        <!--  Enter a friend's code  -->
        <ContentDialog
            x:Name="CodeDialog"
            Title="Follow a friend"
            CloseButtonText="Cancel"
            DefaultButton="Primary"
            IsPrimaryButtonEnabled="{x:Bind ViewModel.CanFollowCode, Mode=OneWay}"
            PrimaryButtonClick="CodeDialog_PrimaryButtonClick"
            PrimaryButtonText="Follow">
            <StackPanel Width="320" Spacing="10">
                <TextBox
                    Height="44"
                    AutomationProperties.Name="Your friend's code"
                    CharacterSpacing="80"
                    FontFamily="Consolas"
                    FontSize="18"
                    IsSpellCheckEnabled="False"
                    MaxLength="9"
                    PlaceholderText="K7MQ-2XPA"
                    Text="{x:Bind ViewModel.CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanging="Code_TextChanging" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.CodeError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasCodeError, Mode=OneWay}" />
            </StackPanel>
        </ContentDialog>

        <!--  Who follows you  -->
        <ContentDialog
            x:Name="FollowersDialog"
            Title="Followers"
            CloseButtonText="Done">
            <StackPanel Width="360" Spacing="12">
                <TextBlock
                    Style="{StaticResource MutedTextStyle}"
                    Text="No one yet. Share your wallpaper and friends who follow show up here."
                    Visibility="{x:Bind ViewModel.HasNoFollowers, Mode=OneWay}" />
                <ScrollViewer MaxHeight="320" Visibility="{x:Bind ViewModel.HasFollowers, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.FollowerRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FollowerRow">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="36"
                                        Height="36"
                                        Background="{ThemeResource OrielInkBrush}"
                                        CornerRadius="18">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource OrielPaperBrush}"
                                            Text="{x:Bind Initial}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Style="{StaticResource MutedTextStyle}" Text="{x:Bind Since}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="RemoveFollower_Click"
                                        Content="{x:Bind RemoveText, Mode=OneWay}"
                                        Style="{StaticResource PillButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
