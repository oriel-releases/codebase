<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.FriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oriel.UI">

    <ScrollViewer>
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource PageMaxWidth}"
                Margin="{StaticResource PageContentMargin}"
                Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Friends" />
                    <TextBlock
                        Style="{StaticResource MutedTextStyle}"
                        Text="Share your wallpaper, or show a friend's on your desktop. It follows every change."
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  ============ Share your wallpaper ============  -->
                <StackPanel
                    Padding="24"
                    Background="{ThemeResource OrielSurfaceBrush}"
                    CornerRadius="{StaticResource OrielLargeRadius}"
                    Spacing="18">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="44"
                            Height="44"
                            Background="{ThemeResource OrielPaperBrush}"
                            CornerRadius="14">
                            <FontIcon FontSize="18" Glyph="&#xE72D;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Share your wallpaper" />
                            <TextBlock
                                Style="{StaticResource MutedTextStyle}"
                                Text="Friends with your code see the wallpaper on your desktop, every time it changes."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!--  Not sharing yet  -->
                    <Button
                        Height="40"
                        Command="{x:Bind ViewModel.StartSharingCommand}"
                        Content="Create my code"
                        Style="{StaticResource PrimaryPillButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsNotSharing, Mode=OneWay}" />

                    <!--  Sharing: the code, big enough to read out loud  -->
                    <Grid
                        Padding="20,16"
                        Background="{ThemeResource OrielPaperBrush}"
                        ColumnSpacing="12"
                        CornerRadius="{StaticResource OrielCardRadius}"
                        Visibility="{x:Bind ViewModel.IsSharing, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                CharacterSpacing="120"
                                FontFamily="Consolas"
                                FontSize="30"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.MyCode, Mode=OneWay}" />
                            <TextBlock
                                FontSize="13"
                                Style="{StaticResource MutedTextStyle}"
                                Text="{x:Bind ViewModel.FollowersText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Height="40"
                                AutomationProperties.Name="Copy the code"
                                Click="CopyCode_Click"
                                Style="{StaticResource PrimaryPillButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" Visibility="{x:Bind local:Star.Hidden(ViewModel.IsCopied), Mode=OneWay}" />
                                    <FontIcon FontSize="14" Glyph="&#xE73E;" Visibility="{x:Bind local:Star.Shown(ViewModel.IsCopied), Mode=OneWay}" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button
                                Height="40"
                                Command="{x:Bind ViewModel.StopSharingCommand}"
                                Content="Stop sharing"
                                Style="{StaticResource PillButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasSharingError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.SharingError, Mode=OneWay}"
                        Severity="Warning" />
                </StackPanel>

                <!--  ============ Follow a friend ============  -->
                <StackPanel
                    Padding="24"
                    Background="{ThemeResource OrielSurfaceBrush}"
                    CornerRadius="{StaticResource OrielLargeRadius}"
                    Spacing="18">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="44"
                            Height="44"
                            Background="{ThemeResource OrielPaperBrush}"
                            CornerRadius="14">
                            <FontIcon FontSize="18" Glyph="&#xE716;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="Follow a friend" />
                            <TextBlock
                                Style="{StaticResource MutedTextStyle}"
                                Text="Enter their code and your desktop shows their wallpaper. Your own schedule pauses until you unfollow."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!--  Not following: one field and one button  -->
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsNotFollowing, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Height="40"
                            AutomationProperties.Name="Friend's code"
                            CharacterCasing="Upper"
                            FontFamily="Consolas"
                            FontSize="16"
                            KeyDown="Code_KeyDown"
                            MaxLength="9"
                            PlaceholderText="K7MQ-2XPA"
                            Style="{StaticResource PillTextBoxStyle}"
                            Text="{x:Bind ViewModel.CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Height="40"
                            MinWidth="110"
                            Command="{x:Bind ViewModel.FollowCommand}"
                            Content="Follow"
                            Style="{StaticResource PrimaryPillButtonStyle}" />
                    </Grid>

                    <!--  Following: who, and the way out  -->
                    <Grid
                        Padding="16"
                        Background="{ThemeResource OrielPaperBrush}"
                        ColumnSpacing="14"
                        CornerRadius="{StaticResource OrielCardRadius}"
                        Visibility="{x:Bind ViewModel.IsFollowing, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="44"
                            Height="44"
                            Background="{ThemeResource OrielInkBrush}"
                            CornerRadius="22">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource OrielPaperBrush}"
                                Text="{x:Bind ViewModel.FollowingInitial, Mode=OneWay}" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Following" />
                                <Run Text="{x:Bind ViewModel.FollowingName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                FontSize="13"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Your desktop shows their wallpaper as it changes."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Height="40"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.UnfollowCommand}"
                            Content="Unfollow"
                            Style="{StaticResource PillButtonStyle}" />
                    </Grid>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasFollowError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.FollowError, Mode=OneWay}"
                        Severity="Warning" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasFollowProblem, Mode=OneWay}"
                        Message="{x:Bind ViewModel.FollowProblem, Mode=OneWay}"
                        Severity="Informational" />
                </StackPanel>

                <!--  ============ How it works ============  -->
                <TextBlock
                    Margin="2,8,0,0"
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="How it works" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Padding="18"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        CornerRadius="{StaticResource OrielCardRadius}"
                        Spacing="10">
                        <Border
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource OrielInkBrush}"
                            CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource OrielPaperBrush}" Text="1" />
                        </Border>
                        <TextBlock FontSize="13" Style="{StaticResource MutedTextStyle}" Text="Create your code here." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Padding="18"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        CornerRadius="{StaticResource OrielCardRadius}"
                        Spacing="10">
                        <Border
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource OrielInkBrush}"
                            CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource OrielPaperBrush}" Text="2" />
                        </Border>
                        <TextBlock FontSize="13" Style="{StaticResource MutedTextStyle}" Text="Send it to a friend who has Oriel." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Padding="18"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        CornerRadius="{StaticResource OrielCardRadius}"
                        Spacing="10">
                        <Border
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource OrielInkBrush}"
                            CornerRadius="14">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource OrielPaperBrush}" Text="3" />
                        </Border>
                        <TextBlock FontSize="13" Style="{StaticResource MutedTextStyle}" Text="Their desktop follows yours. Stop sharing any time." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
