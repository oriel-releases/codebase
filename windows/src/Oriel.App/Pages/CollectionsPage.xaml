<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Oriel.UI"
    xmlns:vm="using:Oriel.UI.ViewModels">

    <ScrollViewer>
        <Grid>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="40,32,40,40">

                <!--  ============ Search: one rounded bar at the top, button inside ============  -->
                <Grid
                    Height="52"
                    Padding="18,0,6,0"
                    Background="{ThemeResource OrielSurfaceBrush}"
                    ColumnSpacing="10"
                    CornerRadius="{StaticResource OrielBarRadius}">
                    <Grid.Resources>
                        <!--  The field is part of the bar: no box, no focus underline of its own.  -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource OrielMutedBrush}"
                        Glyph="&#xE721;" />
                    <TextBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="Search wallpapers"
                        FontSize="15"
                        KeyDown="Search_KeyDown"
                        Loaded="SearchBox_Loaded"
                        PlaceholderText="Search wallpapers, like northern lights or tokyo night"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Clear search"
                        Command="{x:Bind ViewModel.ClearSearchCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Clear"
                        Visibility="{x:Bind ViewModel.HasText, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Height="40"
                        Padding="22,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        CornerRadius="20"
                        Style="{StaticResource PrimaryPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                            <TextBlock Text="Search" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar
                    Title="{x:Bind ViewModel.InfoTitle, Mode=OneWay}"
                    Margin="0,12,0,0"
                    IsOpen="{x:Bind ViewModel.IsInfoOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}" />

                <!--  ============ Start: ideas to search for (gone once you search) ============  -->
                <StackPanel Margin="0,22,0,0" Visibility="{x:Bind ViewModel.ShowStart, Mode=OneWay}">
                    <TextBlock
                        Margin="2,0,0,10"
                        Style="{StaticResource SectionHeaderStyle}"
                        Text="Try searching for" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Suggestions}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinColumnSpacing="8" MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button
                                    Click="Suggestion_Click"
                                    Content="{x:Bind}"
                                    Style="{StaticResource PillButtonStyle}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!--  ============ Interests: a row that opens its own page, like a Settings category ============  -->
                <Button
                    MinHeight="68"
                    Margin="0,22,0,0"
                    Visibility="{x:Bind ViewModel.ShowStart, Mode=OneWay}"
                    Padding="20,14,16,14"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Interests"
                    Click="Interests_Click"
                    CornerRadius="{StaticResource OrielCardRadius}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{ThemeResource OrielMutedBrush}"
                            Glyph="&#xE8B3;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Interests" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource OrielMutedBrush}"
                                Text="{x:Bind ViewModel.MixSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource OrielMutedBrush}"
                            Glyph="&#xE76C;" />
                    </Grid>
                </Button>

                <!--  ============ Results: photo first, credit and action on the photo ============  -->
                <StackPanel Margin="0,8,0,0" Visibility="{x:Bind ViewModel.HasSearched, Mode=OneWay}">
                    <Grid Margin="0,8,0,12">
                        <TextBlock
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind ViewModel.ResultsTitle, Mode=OneWay}" />
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.AddToMixCommand}"
                            Style="{StaticResource PillButtonStyle}"
                            ToolTipService.ToolTip="Add this search to your Interests, so the daily wallpaper can come from it"
                            Visibility="{x:Bind ViewModel.CanAddToMix, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Add to Interests" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Nothing found  -->
                    <StackPanel
                        Padding="24,40"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        CornerRadius="{StaticResource OrielLargeRadius}"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}">
                        <FontIcon
                            Margin="0,0,0,6"
                            HorizontalAlignment="Center"
                            FontSize="28"
                            Foreground="{ThemeResource OrielMutedBrush}"
                            Glyph="&#xE721;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="No photos found" />
                        <TextBlock
                            MaxWidth="360"
                            HorizontalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Try other or fewer words. Only photos big enough for your screen are shown."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Results}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="14"
                                MinItemWidth="280"
                                MinRowSpacing="14" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhotoResultViewModel">
                                <Grid
                                    Height="210"
                                    Background="{ThemeResource OrielLineBrush}"
                                    CornerRadius="{StaticResource OrielCardRadius}">
                                    <Image
                                        local:ImageReveal.Enabled="True"
                                        AutomationProperties.Name="{x:Bind Description}"
                                        Source="{x:Bind Thumbnail}"
                                        Stretch="UniformToFill"
                                        ToolTipService.ToolTip="{x:Bind Size}" />
                                    <!--  The fade keeps the white text readable on any photo.  -->
                                    <Grid
                                        Padding="14,44,10,10"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource OrielPhotoScrimBrush}"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton
                                            Margin="-6,0,0,0"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Content="{x:Bind PhotographerName}"
                                            FontSize="12"
                                            Foreground="White"
                                            NavigateUri="{x:Bind PhotographerUri}"
                                            ToolTipService.ToolTip="Photographer on Unsplash">
                                            <HyperlinkButton.Resources>
                                                <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#E0E0E0" />
                                                <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#C0C0C0" />
                                            </HyperlinkButton.Resources>
                                        </HyperlinkButton>
                                        <Button
                                            Grid.Column="1"
                                            Padding="14,5"
                                            Command="{x:Bind SetCommand}"
                                            FontSize="13"
                                            IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                                            Style="{StaticResource PillButtonStyle}">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackground" Color="#F2F2F2" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E0E0E0" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D0D0D0" />
                                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#F2F2F2" />
                                                <SolidColorBrush x:Key="ButtonForeground" Color="#141414" />
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#141414" />
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#141414" />
                                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6B6B6B" />
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ProgressRing
                                                    Width="12"
                                                    Height="12"
                                                    Foreground="#141414"
                                                    IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                    Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind ButtonText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Content="Show more"
                        Style="{StaticResource PillButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
