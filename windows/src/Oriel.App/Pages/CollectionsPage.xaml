<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:Oriel.UI"
    xmlns:vm="using:Oriel.UI.ViewModels"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!--  A photo and its credit, the same card as History's: search results and Explore alike.  -->
        <DataTemplate x:Key="PhotoCard" x:DataType="vm:PhotoResultViewModel">
            <!--  A click opens the photo on its own page, with its actions.  -->
            <Grid
                Height="210"
                Background="{ThemeResource OrielLineBrush}"
                CornerRadius="{StaticResource OrielCardRadius}"
                PointerEntered="Card_PointerEntered"
                Tag="{x:Bind}"
                Tapped="Card_Tapped">
                <Image
                    local:ImageReveal.Enabled="True"
                    AutomationProperties.Name="{x:Bind Headline}"
                    Source="{x:Bind Preview, Mode=OneWay}"
                    Stretch="UniformToFill" />
                <FontIcon
                    Margin="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontSize="16"
                    Foreground="{StaticResource OrielStarBrush}"
                    Glyph="&#xE735;"
                    Visibility="{x:Bind local:Star.Shown(IsFavorite), Mode=OneWay}" />
                <!--  The fade keeps the white text readable on any photo.  -->
                <StackPanel
                    Padding="14,44,14,12"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource OrielPhotoScrimBrush}">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{x:Bind PhotographerName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#CCFFFFFF"
                        Text="{x:Bind Subtitle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--  A focus change never scrolls the page: opening a card moved the focus to the search box at the top, and the page
         jumped up there before the photo opened.  -->
    <ScrollViewer x:Name="Scroller" BringIntoViewOnFocusChange="False" ViewChanged="Scroller_ViewChanged">
        <Grid>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="40,32,40,40">

                <!--  ============ Search: one rounded bar at the top, button inside ============  -->
                <Grid
                    Height="52"
                    Padding="18,0,6,0"
                    Background="{ThemeResource OrielSurfaceBrush}"
                    ColumnSpacing="10"
                    CornerRadius="{StaticResource OrielBarRadius}">
                    <Grid.Resources>
                        <!--  The field is part of the bar: no box, no focus underline of its own.  -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource OrielMutedBrush}"
                        Glyph="&#xE721;" />
                    <TextBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="Search wallpapers"
                        FontSize="15"
                        KeyDown="Search_KeyDown"
                        Loaded="SearchBox_Loaded"
                        PlaceholderText="Search wallpapers, like northern lights or tokyo night"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Clear search"
                        Command="{x:Bind ViewModel.ClearSearchCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Clear"
                        Visibility="{x:Bind ViewModel.HasText, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Height="40"
                        Padding="22,0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        CornerRadius="20"
                        Style="{StaticResource PrimaryPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                            <TextBlock Text="Search" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar
                    Title="{x:Bind ViewModel.InfoTitle, Mode=OneWay}"
                    Margin="0,12,0,0"
                    IsOpen="{x:Bind ViewModel.IsInfoOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}" />

                <!--  ============ Interests: a compact row that opens its own page, like the Friends and Settings rows ============  -->
                <Button
                    MinHeight="56"
                    Margin="0,16,0,0"
                    Visibility="{x:Bind ViewModel.ShowStart, Mode=OneWay}"
                    Padding="16,10,14,10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Interests"
                    Click="Interests_Click"
                    CornerRadius="{StaticResource OrielLargeRadius}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            Background="{ThemeResource OrielPaperBrush}"
                            CornerRadius="{StaticResource OrielTileRadius}">
                            <FontIcon FontSize="14" Glyph="&#xEB51;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Interests" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource OrielMutedBrush}"
                                Text="{x:Bind ViewModel.MixSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <FontIcon
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource OrielMutedBrush}"
                            Glyph="&#xE76C;" />
                    </Grid>
                </Button>

                <!--  ============ Explore: this hour's wallpapers, the same for everyone (gone while searching) ============  -->
                <StackPanel Margin="0,28,0,0" Visibility="{x:Bind ViewModel.ShowStart, Mode=OneWay}">
                    <!--  Refresh (or F5): a new hour's photos when they're out, else these in a new order.  -->
                    <Grid Margin="2,0,0,12">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="Fresh picks for you" />
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Refresh fresh picks"
                            Command="{x:Bind ViewModel.RefreshExploreCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Refresh (F5)">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </Button.KeyboardAccelerators>
                            <Grid>
                                <FontIcon FontSize="15" Glyph="&#xE72C;" Visibility="{x:Bind local:Star.Hidden(ViewModel.IsExploreRefreshing), Mode=OneWay}" />
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind ViewModel.IsExploreRefreshing, Mode=OneWay}"
                                    Visibility="{x:Bind local:Star.Shown(ViewModel.IsExploreRefreshing), Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </Grid>
                    <ProgressRing
                        Width="28"
                        Height="28"
                        Margin="0,24"
                        HorizontalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsExploreLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsExploreLoading, Mode=OneWay}" />
                    <TextBlock
                        Margin="2,0,0,0"
                        Style="{StaticResource MutedTextStyle}"
                        Text="Fresh picks couldn't load right now. Check your connection, or search for something above."
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ExploreUnavailable, Mode=OneWay}" />
                    <ItemsRepeater ItemTemplate="{StaticResource PhotoCard}" ItemsSource="{x:Bind ViewModel.Explore}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="14"
                                MinItemWidth="280"
                                MinRowSpacing="14" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <!--  ============ Results: photo first, credit and action on the photo ============  -->
                <StackPanel Margin="0,8,0,0" Visibility="{x:Bind ViewModel.HasSearched, Mode=OneWay}">
                    <Grid Margin="0,8,0,12">
                        <TextBlock
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="{x:Bind ViewModel.ResultsTitle, Mode=OneWay}" />
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.AddToMixCommand}"
                            Style="{StaticResource PillButtonStyle}"
                            ToolTipService.ToolTip="Add this search to your Interests, so the daily wallpaper can come from it"
                            Visibility="{x:Bind ViewModel.CanAddToMix, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Add to Interests" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Nothing found  -->
                    <StackPanel
                        Padding="24,40"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        CornerRadius="{StaticResource OrielLargeRadius}"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}">
                        <FontIcon
                            Margin="0,0,0,6"
                            HorizontalAlignment="Center"
                            FontSize="28"
                            Foreground="{ThemeResource OrielMutedBrush}"
                            Glyph="&#xE721;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="No photos found" />
                        <TextBlock
                            MaxWidth="360"
                            HorizontalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Try other or fewer words. Only photos big enough for your screen are shown."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsRepeater ItemTemplate="{StaticResource PhotoCard}" ItemsSource="{x:Bind ViewModel.Results}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="14"
                                MinItemWidth="280"
                                MinRowSpacing="14" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>

                    <Button
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Content="Show more"
                        Style="{StaticResource PillButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
