<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oriel.UI"
    xmlns:vm="using:Oriel.UI.ViewModels">

    <!--  A checked favorite keeps the soft grey button; only its star turns yellow (see Star).  -->
    <Page.Resources>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource OrielSurface}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource OrielLine}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource OrielLine}" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
    </Page.Resources>

    <ScrollViewer>
        <Grid>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageContentMargin}">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="History" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Grid
                        Padding="3"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        CornerRadius="{StaticResource OrielPillRadius}">
                        <Border
                            x:Name="ViewIndicator"
                            Background="{ThemeResource OrielInkBrush}"
                            CornerRadius="{StaticResource OrielTabItemRadius}" />
                        <StackPanel
                            x:Name="ViewStrip"
                            Orientation="Horizontal"
                            Spacing="2">
                            <RadioButton
                                AutomationProperties.Name="Grid view"
                                GroupName="HistoryView"
                                IsChecked="{x:Bind ViewModel.IsGrid, Mode=TwoWay}"
                                Style="{StaticResource PillTabStyle}"
                                ToolTipService.ToolTip="Grid">
                                <FontIcon FontSize="14" Glyph="&#xF0E2;" />
                            </RadioButton>
                            <RadioButton
                                AutomationProperties.Name="List view"
                                GroupName="HistoryView"
                                IsChecked="{x:Bind ViewModel.IsList, Mode=TwoWay}"
                                Style="{StaticResource PillTabStyle}"
                                ToolTipService.ToolTip="List">
                                <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                                    <ComboBox
                        MinWidth="130"
                                            AutomationProperties.Name="Show"
                        SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}">
                        <x:String>All</x:String>
                        <x:String>Favorites</x:String>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <InfoBar
                Margin="0,0,0,12"
                IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="Informational" />

            <StackPanel
                Margin="0,80,0,0"
                HorizontalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <Image
                    Width="48"
                    Height="48"
                    Opacity="0.25"
                    Source="{ThemeResource OrielLogoImage}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource MutedTextStyle}"
                    Text="Nothing here yet." />
            </StackPanel>

            <!--  ItemsRepeater: a plain responsive grid, no list selection chrome  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items}" Visibility="{x:Bind ViewModel.IsGrid, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemWidth="300"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Grid
                            Height="210"
                            Background="{ThemeResource OrielLineBrush}"
                            CornerRadius="{StaticResource OrielCardRadius}"
                            GotFocus="Card_Focus"
                            LostFocus="Card_Blur"
                            PointerEntered="Card_Enter"
                            PointerExited="Card_Exit">
                            <Image
                                AutomationProperties.Name="{x:Bind Topic}"
                                Source="{x:Bind Thumbnail, Mode=OneWay}"
                                Stretch="UniformToFill" />

                            <!--  Favorites keep a small star on the photo even when the actions are hidden.  -->
                            <FontIcon
                                Margin="12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                FontSize="16"
                                Foreground="{StaticResource OrielStarBrush}"
                                Glyph="&#xE735;"
                                Visibility="{x:Bind local:Star.Shown(IsFavorite), Mode=OneWay}" />

                            <Grid
                                Padding="14,44,10,10"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource OrielPhotoScrimBrush}"
                                ColumnSpacing="8">
                                <Grid.Resources>
                                    <ResourceDictionary Source="ms-appx:///Styles/OnPhoto.xaml" />
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="Details" Grid.ColumnSpan="2" VerticalAlignment="Center">
                                    <HyperlinkButton
                                        Margin="-6,0,0,0"
                                        Padding="6,1"
                                        Content="{x:Bind PhotographerName}"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        NavigateUri="{x:Bind PhotographerUri}"
                                        ToolTipService.ToolTip="Photographer on Unsplash" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#CCFFFFFF"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap">
                                        <Run Text="{x:Bind DateText}" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind Topic}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel
                                    x:Name="Actions"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        AutomationProperties.Name="Set as wallpaper again"
                                        Command="{x:Bind ReapplyCommand}"
                                        IsEnabled="{x:Bind FileExists}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="Set as wallpaper again">
                                        <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                                    </Button>
                                    <ToggleButton
                                        AutomationProperties.Name="Favorite"
                                        IsChecked="{x:Bind IsFavorite, Mode=TwoWay}"
                                        Style="{StaticResource IconToggleButtonStyle}"
                                        ToolTipService.ToolTip="Favorite: never auto-delete">
                                        <Grid>
                                            <FontIcon FontSize="14" Glyph="&#xE734;" Visibility="{x:Bind local:Star.Hidden(IsFavorite), Mode=OneWay}" />
                                            <FontIcon FontSize="14" Foreground="{StaticResource OrielStarBrush}" Glyph="&#xE735;" Visibility="{x:Bind local:Star.Shown(IsFavorite), Mode=OneWay}" />
                                        </Grid>
                                    </ToggleButton>
                                    <Button
                                        AutomationProperties.Name="Open in folder"
                                        Command="{x:Bind OpenInFolderCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="Open in folder">
                                        <FontIcon FontSize="14" Glyph="&#xED25;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Delete"
                                        Command="{x:Bind DeleteCommand}"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTipService.ToolTip="Delete">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--  List: one compact row per wallpaper  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items}" Visibility="{x:Bind ViewModel.IsList, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Grid
                            Padding="8"
                            Background="{ThemeResource OrielSurfaceBrush}"
                            ColumnSpacing="14"
                            CornerRadius="{StaticResource OrielMediumRadius}"
                            GotFocus="Card_Focus"
                            LostFocus="Card_Blur"
                            PointerEntered="Card_Enter"
                            PointerExited="Card_Exit">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="112"
                                Height="64"
                                Background="{ThemeResource OrielLineBrush}"
                                CornerRadius="{StaticResource OrielThumbRadius}">
                                <Image
                                    AutomationProperties.Name="{x:Bind Topic}"
                                    Source="{x:Bind Thumbnail, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel x:Name="Details" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
                                <HyperlinkButton
                                    Margin="-6,0,0,0"
                                    Padding="6,1"
                                    Content="{x:Bind PhotographerName}"
                                    FontWeight="SemiBold"
                                    NavigateUri="{x:Bind PhotographerUri}"
                                    ToolTipService.ToolTip="Photographer on Unsplash" />
                                <TextBlock
                                    FontSize="12"
                                    Style="{StaticResource MutedTextStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <Run Text="{x:Bind DateText}" />
                                    <Run Text=" · " />
                                    <Run Text="{x:Bind Topic}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel
                                x:Name="Actions"
                                Opacity="0"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    AutomationProperties.Name="Set as wallpaper again"
                                    Command="{x:Bind ReapplyCommand}"
                                    IsEnabled="{x:Bind FileExists}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Set as wallpaper again">
                                    <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                                </Button>
                                <ToggleButton
                                    AutomationProperties.Name="Favorite"
                                    IsChecked="{x:Bind IsFavorite, Mode=TwoWay}"
                                    Style="{StaticResource IconToggleButtonStyle}"
                                    ToolTipService.ToolTip="Favorite: never auto-delete">
                                    <Grid>
                                        <FontIcon FontSize="14" Glyph="&#xE734;" Visibility="{x:Bind local:Star.Hidden(IsFavorite), Mode=OneWay}" />
                                        <FontIcon FontSize="14" Foreground="{StaticResource OrielStarBrush}" Glyph="&#xE735;" Visibility="{x:Bind local:Star.Shown(IsFavorite), Mode=OneWay}" />
                                    </Grid>
                                </ToggleButton>
                                <Button
                                    AutomationProperties.Name="Open in folder"
                                    Command="{x:Bind OpenInFolderCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Open in folder">
                                    <FontIcon FontSize="14" Glyph="&#xED25;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Delete"
                                    Command="{x:Bind DeleteCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Delete">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
