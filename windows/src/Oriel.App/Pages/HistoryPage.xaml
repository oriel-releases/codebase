<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Oriel.UI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oriel.UI"
    xmlns:vm="using:Oriel.UI.ViewModels"
    NavigationCacheMode="Enabled">

    <!--  A checked favorite keeps the soft grey button; only its star turns yellow (see Star).  -->
    <Page.Resources>
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource OrielSurface}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource OrielLine}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource OrielLine}" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
    </Page.Resources>

    <!--  A focus change never scrolls the page (opening a card could jump it to the top first).  -->
    <ScrollViewer BringIntoViewOnFocusChange="False">
        <Grid>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageContentMargin}">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <!--  "Set again": what it's doing now, the same words as on Home and Search.  -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsChanging, Mode=OneWay}">
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{x:Bind ViewModel.IsChanging, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind ViewModel.Stage, Mode=OneWay}" />
                    </StackPanel>
                    <!--  Grid or list, like the phone's segmented control: a soft track, and an ink pill sliding to the pick.  -->
                    <Grid
                        Padding="3"
                        Background="{ThemeResource OrielSurfaceBrush}"
                        BorderBrush="{ThemeResource OrielLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OrielPillRadius}">
                        <Border
                            x:Name="ViewIndicator"
                            Background="{ThemeResource OrielInkBrush}"
                            CornerRadius="{StaticResource OrielPillRadius}" />
                        <StackPanel x:Name="ViewStrip" Orientation="Horizontal">
                            <RadioButton
                                Width="78"
                                AutomationProperties.Name="Grid view"
                                GroupName="HistoryView"
                                IsChecked="{x:Bind ViewModel.IsGrid, Mode=TwoWay}"
                                Style="{StaticResource PillTabStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="12" Glyph="&#xF0E2;" />
                                    <TextBlock Text="Grid" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                Width="78"
                                AutomationProperties.Name="List view"
                                GroupName="HistoryView"
                                IsChecked="{x:Bind ViewModel.IsList, Mode=TwoWay}"
                                Style="{StaticResource PillTabStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                                    <TextBlock Text="List" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <InfoBar
                Margin="0,0,0,12"
                IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="Informational" />

            <StackPanel
                Margin="0,80,0,0"
                HorizontalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <Image
                    Width="48"
                    Height="48"
                    Opacity="0.25"
                    Source="{ThemeResource OrielLogoImage}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" />
            </StackPanel>

            <!--  ItemsRepeater: a plain responsive grid, no list selection chrome  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsGrid, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemWidth="300"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Grid
                            Height="210"
                            Background="{ThemeResource OrielLineBrush}"
                            CornerRadius="{StaticResource OrielCardRadius}"
                            PointerEntered="Card_PointerEntered"
                            Tag="{x:Bind}"
                            Tapped="Card_Tapped">
                            <Image
                                local:ImageReveal.Enabled="True"
                                AutomationProperties.Name="{x:Bind Headline}"
                                Source="{x:Bind Preview, Mode=OneWay}"
                                Stretch="UniformToFill" />
                            <FontIcon
                                Margin="12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                FontSize="16"
                                Foreground="{StaticResource OrielStarBrush}"
                                Glyph="&#xE735;"
                                Visibility="{x:Bind local:Star.Shown(IsFavorite), Mode=OneWay}" />
                            <!--  The fade keeps the white text readable on any photo.  -->
                            <StackPanel
                                Padding="14,44,14,12"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource OrielPhotoScrimBrush}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{x:Bind PhotographerName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#CCFFFFFF"
                                    Text="{x:Bind Subtitle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--  List: one compact row per wallpaper  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsList, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <Grid
                            Padding="8"
                            Background="{ThemeResource OrielSurfaceBrush}"
                            ColumnSpacing="14"
                            CornerRadius="{StaticResource OrielMediumRadius}"
                            PointerEntered="Card_PointerEntered"
                            Tag="{x:Bind}"
                            Tapped="Card_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                x:Name="Thumb"
                                Width="112"
                                Height="64"
                                Background="{ThemeResource OrielLineBrush}"
                                CornerRadius="{StaticResource OrielThumbRadius}">
                                <Image
                                    local:ImageReveal.Enabled="True"
                                    AutomationProperties.Name="{x:Bind Headline}"
                                    Source="{x:Bind Preview, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind PhotographerName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="{x:Bind Subtitle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                FontSize="14"
                                Foreground="{StaticResource OrielStarBrush}"
                                Glyph="&#xE735;"
                                Visibility="{x:Bind local:Star.Shown(IsFavorite), Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
