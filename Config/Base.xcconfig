// Shared build settings. Secrets.xcconfig is generated by scripts/configure.sh (git-ignored)
// and sets UNSPLASH_ACCESS_KEY; without it the app builds but can't fetch photos.
UNSPLASH_ACCESS_KEY =
// Sparkle's public EdDSA key (scripts/configure.sh reads it from .env); empty: updates are off.
SPARKLE_PUBLIC_KEY =
#include? "Secrets.xcconfig"
