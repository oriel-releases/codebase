# Copy to linux/.env (git-ignored). Both keys are built into the app (Oriel.Core.csproj); an environment variable
# with the same name (CI: LINUX_UNSPLASH_ACCESS_KEY / LINUX_POLLINATIONS_KEY secrets) wins over this file.

# Unsplash access key, for every photo: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=

# Pollinations key, for AI wallpapers on the Create page: https://enter.pollinations.ai/keys
# It ships inside the app, so give it a Pollen budget and allow only image models.
POLLINATIONS_KEY=
