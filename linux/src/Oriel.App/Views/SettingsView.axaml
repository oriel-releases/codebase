<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oriel.UI.ViewModels"
             xmlns:views="using:Oriel.UI.Views"
             xmlns:controls="using:Oriel.UI.Controls"
             x:Class="Oriel.UI.Views.SettingsView"
             xmlns:zones="using:Oriel.Core.Settings"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <!--  A section's rows, in one rounded list like Friends (the rows draw the lines between them).  -->
        <Style Selector="Border.group">
            <Setter Property="Background" Value="{DynamicResource OrielSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource OrielLarge}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.row">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource OrielPaperBrush}" />
        </Style>
    </UserControl.Styles>

    <!--
        The same sections as Windows and the phone: Account, Schedule and Photos (shared by every device), Display and App
        (this computer), and About.
    -->
    <ScrollViewer>
        <StackPanel MaxWidth="960" Margin="40,8,40,40">
            <TextBlock Classes="title" Text="Settings" />

            <!--  ============ Account ============  -->
            <TextBlock Classes="section" Margin="2,12,0,8" Text="Account" />
            <Border Classes="group">
                <Grid MinHeight="56" Margin="16,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <!--  Oriel's logo, covered by the Google photo once that loads.  -->
                    <Panel Width="32" Height="32" VerticalAlignment="Center">
                        <Border Background="{DynamicResource OrielPaperBrush}" CornerRadius="16">
                            <Image Width="18" Height="18" Source="{DynamicResource OrielLogo}" />
                        </Border>
                        <Border CornerRadius="16" ClipToBounds="True" IsVisible="{Binding AccountPhoto, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Image Source="{Binding AccountPhoto}" Stretch="UniformToFill" />
                        </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding AccountName}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding AccountEmail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="row" Content="Devices" Command="{Binding OpenAccountCommand}" ToolTip.Tip="Your account and devices, on the website" />
                        <Button Classes="row" Content="Sign out" Command="{Binding SignOutCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ============ Schedule (every device) ============  -->
            <TextBlock Classes="section" Text="Schedule" />
            <Border Classes="group">
                <StackPanel>
                    <controls:SettingRow First="True" Icon="{StaticResource IconRefresh}" Header="Change wallpaper"
                                         Description="Once a day, or as a slideshow through the day.">
                        <ComboBox MinWidth="150" ItemsSource="{Binding IntervalOptions}" SelectedIndex="{Binding IntervalIndex}" />
                    </controls:SettingRow>
                    <controls:SettingRow x:Name="DailyTimeRow" Icon="{StaticResource IconClock}" Header="Daily change time"
                                         Description="A new wallpaper once a day at this time.">
                        <controls:SettingRow.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
                            </Transitions>
                        </controls:SettingRow.Transitions>
                        <!--  Wired in code-behind: a TwoWay binding on a TimePicker can push 00:00 back on load.  -->
                        <TimePicker x:Name="DailyTimePicker" ClockIdentifier="24HourClock" MinuteIncrement="5" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconGlobe}" Header="Time zone" Description="The change time follows it, on all your devices.">
                        <ComboBox MinWidth="240" ItemsSource="{Binding Zones}" SelectedIndex="{Binding ZoneIndex}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="zones:ZoneChoice">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingRow>
                    <controls:SettingRow x:Name="ApplyAtLoginRow" Icon="{StaticResource IconPower}" Header="Change at login"
                                         Description="Missed today's change while off? Change it when you log in.">
                        <controls:SettingRow.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
                            </Transitions>
                        </controls:SettingRow.Transitions>
                        <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding ApplyAtLogin}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!--  ============ Photos (every device) ============  -->
            <TextBlock Classes="section" Text="Photos" />
            <Border Classes="group">
                <StackPanel>
                    <controls:SettingRow First="True" Icon="{StaticResource IconStar}" Header="Pick from"
                                         Description="Only the photos you starred. With none, new photos are used.">
                        <ComboBox MinWidth="150" ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding SourceIndex}" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconSun}" Header="Match the time of day"
                                         Description="Darker photos in the evening, brighter ones in the morning.">
                        <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding MatchTimeOfDay}" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconHeart}" Header="Popular photos only" Description="Prefer photos other people liked on Unsplash.">
                        <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding SkipLowLikes}" />
                    </controls:SettingRow>
                    <!--  Slides and fades in under its switch, and back out (SettingsView.ShowMinLikes).  -->
                    <controls:SettingRow x:Name="MinLikesRow" Icon="{StaticResource IconThumb}" Header="Minimum likes">
                        <controls:SettingRow.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
                            </Transitions>
                        </controls:SettingRow.Transitions>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Slider Width="220" VerticalAlignment="Center" Minimum="300" Maximum="1000" SmallChange="50" LargeChange="100"
                                    TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding MinLikes}" />
                            <TextBlock MinWidth="90" VerticalAlignment="Center" Text="{Binding MinLikesText}" />
                        </StackPanel>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!--  ============ Display (this computer) ============  -->
            <TextBlock Classes="section" Text="Display" />
            <Border Classes="group">
                <StackPanel>
                    <controls:SettingRow First="True" Icon="{StaticResource IconImage}" Header="Fit"
                                         Description="How the photo fits. Span stretches one across all monitors.">
                        <ComboBox MinWidth="110" ItemsSource="{Binding FitModes}" SelectedIndex="{Binding FitIndex}" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconLock}" Header="Apply to" Description="{Binding ApplyToNote}">
                        <ComboBox MinWidth="190" ItemsSource="{Binding ApplyToOptions}" SelectedIndex="{Binding ApplyToIndex}" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconMonitor}" Header="A photo for each monitor"
                                         Description="Each monitor gets its own photo." IsVisible="{Binding HasMonitors}">
                        <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding PhotoPerMonitor}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!--  ============ App (this computer) ============  -->
            <TextBlock Classes="section" Text="App" />
            <views:InfoBanner Margin="0,0,0,8" DataContext="{Binding FolderInfo}" />
            <Border Classes="group">
                <StackPanel>
                    <controls:SettingRow First="True" Icon="{StaticResource IconPower}" Header="Start at login"
                                         Description="Start quietly in the tray when you log in.">
                        <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding StartAtLogin}" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconKeyboard}" Header="Next wallpaper shortcut" Description="{Binding ShortcutNote}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ShortcutBox" Width="170" IsReadOnly="True" PlaceholderText="Click, then press keys"
                                     Text="{Binding Shortcut, Mode=OneWay}" />
                            <Button Classes="row" Content="Clear" Command="{Binding ClearShortcutCommand}" />
                        </StackPanel>
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconFolder}" Header="Wallpaper folder" Description="{Binding PicturesFolder}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="row" Content="Open" Command="{Binding OpenPicturesFolderCommand}" />
                            <Button Classes="row" Command="{Binding ChangeFolderCommand}" ToolTip.Tip="Pick an empty folder; your photos move there.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Arc Classes="spinner" Classes.busy="{Binding IsMovingFolder}" Stroke="{DynamicResource OrielInkBrush}" />
                                    <TextBlock Text="Change" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconDownload}" Header="Updates" Description="{Binding UpdateStatus}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressBar Width="120" VerticalAlignment="Center" Maximum="100" Value="{Binding UpdateProgress}" IsVisible="{Binding IsDownloading}" />
                            <Button Classes="row" Command="{Binding UpdateCommand}" IsVisible="{Binding CanUpdate}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Arc Classes="spinner" Classes.busy="{Binding IsUpdateBusy}" Stroke="{DynamicResource OrielInkBrush}" />
                                    <TextBlock Text="{Binding UpdateButtonText}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!--  ============ About ============  -->
            <TextBlock Classes="section" Text="About" />
            <Border Classes="group">
                <StackPanel>
                    <controls:SettingRow First="True" Icon="{StaticResource IconHelp}" Header="Get help"
                                         Description="Questions, bugs or ideas? The Oriel bot on Telegram.">
                        <Button Classes="row" Content="Open Telegram" Command="{Binding OpenSupportCommand}" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconImage}" Header="Photos by Unsplash"
                                         Description="Every wallpaper is a photo from Unsplash, by the photographer named under it.">
                        <Button Classes="row" Content="Open" Command="{Binding OpenUnsplashCommand}" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconSparkles}" Header="Pictures made with Pollinations"
                                         Description="The AI wallpapers are made by Pollinations.">
                        <Button Classes="row" Content="Open" Command="{Binding OpenPollinationsCommand}" />
                    </controls:SettingRow>
                    <controls:SettingRow Icon="{StaticResource IconShield}" Header="Privacy" Description="What Oriel keeps, and why.">
                        <Button Classes="row" Content="Read" Command="{Binding OpenPrivacyCommand}" />
                    </controls:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
