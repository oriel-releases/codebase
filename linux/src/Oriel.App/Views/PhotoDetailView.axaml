<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oriel.UI.ViewModels"
             x:Class="Oriel.UI.Views.PhotoDetailView"
             x:DataType="vm:IPhotoDetail"
             Background="{DynamicResource OrielPaperBrush}">
    <!--  Laid out like Home: the photo the same size, its credit and actions under it. The same as on Windows.  -->
    <ScrollViewer>
        <StackPanel MaxWidth="960" Margin="40,8,40,40" Spacing="16">
            <Grid Margin="0,16,0,0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Classes="icon" VerticalAlignment="Center" Click="Back_Click" ToolTip.Tip="Back">
                    <PathIcon Data="{StaticResource IconBack}" Width="14" Height="14" />
                </Button>

            </Grid>

            <!--  The card flies here and grows into the photo; a sharp copy, at the screen's real pixels, fades in over it.  -->
            <Border x:Name="PhotoFrame" Height="440" Background="{DynamicResource OrielSurfaceBrush}" CornerRadius="{DynamicResource OrielLarge}" ClipToBounds="True">
                <Panel>
                    <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                    <Image x:Name="LargeImage" Stretch="UniformToFill" Opacity="0">
                        <Image.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                            </Transitions>
                        </Image.Transitions>
                    </Image>
                </Panel>
            </Border>

            <!--  Credit (required by Unsplash guidelines) and actions, like Home's. They rise in once the photo lands.  -->
            <Grid x:Name="Info" ColumnDefinitions="*,Auto" ColumnSpacing="16" Opacity="0">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.45" Easing="0.2,0.9,0.1,1" />
                    </Transitions>
                </Grid.Transitions>
                <!--  The credit, and under it the facts as small pills with icons: size and likes, or when and where it came from.  -->
                <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Photo by" />
                        <Button Classes="link" Content="{Binding PhotographerName}" Click="Photographer_Click" />
                        <TextBlock VerticalAlignment="Center" Text="on" />
                        <Button Classes="link" Content="Unsplash" Click="Page_Click" />
                    </StackPanel>
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Chips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PhotoFact">
                                <Border Height="24" Padding="9,0,10,0" Background="{DynamicResource OrielSurfaceBrush}" CornerRadius="12">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{Binding Icon}" Width="11" Height="11" Foreground="{DynamicResource OrielMutedBrush}" />
                                        <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Text}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <!--  Linux has no system share sheet: the same small menu as on Home.  -->
                    <Button x:Name="ShareButton" Classes="icon" ToolTip.Tip="Share this wallpaper. Whoever opens the link can set it in one click.">
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuItem Header="Copy link" Click="CopyLink_Click" />
                                <!--  No system share sheet here: the picture goes on the clipboard, to paste into a chat with the link.  -->
                                <MenuItem Header="Copy image" Click="CopyImage_Click" />
                                <MenuItem Header="Telegram" Click="ShareTelegram_Click" />
                                <MenuItem Header="WhatsApp" Click="ShareWhatsApp_Click" />
                                <MenuItem Header="Email" Click="ShareEmail_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <PathIcon Data="{StaticResource IconShare}" Width="15" Height="15" />
                    </Button>
                    <Button Classes="icon" Click="Folder_Click" IsVisible="{Binding CanOpenFolder}" ToolTip.Tip="Open in folder">
                        <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" />
                    </Button>
                    <Button Classes="icon" Click="Delete_Click" IsVisible="{Binding CanDelete}" ToolTip.Tip="Delete">
                        <PathIcon Data="{StaticResource IconDelete}" Width="15" Height="15" />
                    </Button>
                    <ToggleButton Classes="icon" IsChecked="{Binding IsFavorite}" IsVisible="{Binding CanFavorite}" ToolTip.Tip="Favorite: keep this one forever">
                        <Panel>
                            <PathIcon Data="{StaticResource IconStar}" Width="15" Height="15" IsVisible="{Binding !IsFavorite}" />
                            <PathIcon Data="{StaticResource IconStarFilled}" Width="15" Height="15"
                                      Foreground="{StaticResource OrielStarBrush}" IsVisible="{Binding IsFavorite}" />
                        </Panel>
                    </ToggleButton>
                    <!--  Its words slide from one step to the next (PhotoDetailView.axaml.cs), like Home's button.  -->
                    <Button x:Name="SetButton" Classes="primary" Height="36" Command="{Binding SetCommand}" IsEnabled="{Binding IsIdle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconMonitor}" Width="14" Height="14" />
                            <TextBlock x:Name="SetText" VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <!--  Already the wallpaper: nothing to set, just said so.  -->
                    <Border x:Name="CurrentPill" Height="36" Padding="16,0" CornerRadius="18" IsVisible="False"
                            Background="{DynamicResource OrielSurfaceBrush}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconCheck}" Width="13" Height="13" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Your wallpaper" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="Message" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
