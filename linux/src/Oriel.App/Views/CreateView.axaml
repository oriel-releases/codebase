<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oriel.UI.ViewModels"
             xmlns:views="using:Oriel.UI.Views"
             xmlns:controls="using:Oriel.UI.Controls"
             x:Class="Oriel.UI.Views.CreateView"
             x:DataType="vm:CreateViewModel">

    <UserControl.Resources>
        <!--  The AI colors: indigo, violet, orchid, soft blue.  -->
        <ConicGradientBrush x:Key="AiRing">
            <GradientStop Offset="0" Color="#5B5BF7" />
            <GradientStop Offset="0.3" Color="#8B5CF6" />
            <GradientStop Offset="0.55" Color="#C084FC" />
            <GradientStop Offset="0.8" Color="#60A5FA" />
            <GradientStop Offset="1" Color="#5B5BF7" />
        </ConicGradientBrush>
        <LinearGradientBrush x:Key="AiGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#5B5BF7" />
            <GradientStop Offset="0.55" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#C084FC" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AiTextGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#5B5BF7" />
            <GradientStop Offset="0.55" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#C084FC" />
        </LinearGradientBrush>
        <StreamGeometry x:Key="Sparkles">M19,1L17.74,3.75L15,5L17.74,6.26L19,9L20.25,6.26L23,5L20.25,3.75M9,4L6.5,9.5L1,12L6.5,14.5L9,20L11.5,14.5L17,12L11.5,9.5M19,15L17.74,17.74L15,19L17.74,20.25L19,23L20.25,20.25L23,19L20.25,17.74</StreamGeometry>
        <!--  Words that change slide up into place, like the Android labels.  -->
        <CompositePageTransition x:Key="WordsSlide">
            <CrossFade Duration="0:0:0.22" />
            <PageSlide Duration="0:0:0.26" Orientation="Vertical" SlideInEasing="CubicEaseOut" SlideOutEasing="CubicEaseIn" />
        </CompositePageTransition>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  The ring's colors turn slowly; the bubbles drift and swell, each on its own path and pace.  -->
        <Style Selector="Border.spin">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="PathIcon.twinkle">
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.86" /><Setter Property="ScaleTransform.ScaleY" Value="0.86" /><Setter Property="RotateTransform.Angle" Value="-12" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1.14" /><Setter Property="ScaleTransform.ScaleY" Value="1.14" /><Setter Property="RotateTransform.Angle" Value="12" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="0.86" /><Setter Property="ScaleTransform.ScaleY" Value="0.86" /><Setter Property="RotateTransform.Angle" Value="-12" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.drift0">
            <Style.Animations>
                <Animation Duration="0:0:18" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="160" /><Setter Property="TranslateTransform.Y" Value="90" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                </Animation>
                <Animation Duration="0:0:10.8" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1.18" /><Setter Property="ScaleTransform.ScaleY" Value="1.18" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.drift1">
            <Style.Animations>
                <Animation Duration="0:0:22" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="-140" /><Setter Property="TranslateTransform.Y" Value="120" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                </Animation>
                <Animation Duration="0:0:13.2" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1.18" /><Setter Property="ScaleTransform.ScaleY" Value="1.18" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.drift2">
            <Style.Animations>
                <Animation Duration="0:0:16" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="150" /><Setter Property="TranslateTransform.Y" Value="-100" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                </Animation>
                <Animation Duration="0:0:9.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1.18" /><Setter Property="ScaleTransform.ScaleY" Value="1.18" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.drift3">
            <Style.Animations>
                <Animation Duration="0:0:24" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="TranslateTransform.X" Value="-170" /><Setter Property="TranslateTransform.Y" Value="-80" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="0" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                </Animation>
                <Animation Duration="0:0:14.4" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1.18" /><Setter Property="ScaleTransform.ScaleY" Value="1.18" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!--  Glowing bubbles behind everything, drifting and swelling  -->
        <Canvas IsHitTestVisible="False">
        <Ellipse Classes="drift0" Canvas.Left="-80" Canvas.Top="-60" Width="440" Height="440">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#705B5BF7" />
                    <GradientStop Offset="0.5" Color="#2C5B5BF7" />
                    <GradientStop Offset="1" Color="#005B5BF7" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Classes="drift1" Canvas.Left="560" Canvas.Top="-100" Width="400" Height="400">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#668B5CF6" />
                    <GradientStop Offset="0.5" Color="#288B5CF6" />
                    <GradientStop Offset="1" Color="#008B5CF6" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Classes="drift2" Canvas.Left="100" Canvas.Top="360" Width="380" Height="380">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#5A60A5FA" />
                    <GradientStop Offset="0.5" Color="#2460A5FA" />
                    <GradientStop Offset="1" Color="#0060A5FA" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Classes="drift3" Canvas.Left="660" Canvas.Top="300" Width="440" Height="440">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform />
                    <TranslateTransform />
                </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#5AC084FC" />
                    <GradientStop Offset="0.5" Color="#24C084FC" />
                    <GradientStop Offset="1" Color="#00C084FC" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        </Canvas>

        <ScrollViewer>
            <StackPanel MaxWidth="960" Margin="40,32,40,40" Spacing="14">

                <!--  The words, inside a turning gradient ring that glows, and "I'm feeling lucky" beside them  -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border CornerRadius="28" ClipToBounds="True" BoxShadow="0 0 26 0 #668B5CF6">
                    <Panel>
                        <Border Classes="spin" Width="1600" Height="1600" Margin="-800" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource AiRing}">
                            <Border.RenderTransform>
                                <RotateTransform />
                            </Border.RenderTransform>
                        </Border>
                        <Border Margin="2" Height="52" Padding="18,0,6,0" Background="{DynamicResource OrielPaperBrush}" CornerRadius="26">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <PathIcon Data="{StaticResource Sparkles}" Width="16" Height="16" Foreground="{StaticResource AiTextGradient}" />
                                <TextBox Grid.Column="1" Classes="bare" VerticalAlignment="Center" VerticalContentAlignment="Center" MaxLength="400"
                                         PlaceholderText="Describe a wallpaper, like a cabin in the snow"
                                         Text="{Binding PromptText}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="2" Classes="primary" Height="40" Padding="22,0" CornerRadius="20" VerticalAlignment="Center"
                                        Command="{Binding CreateCommand}" ToolTip.Tip="{Binding LeftText}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Arc Classes="spinner" Classes.busy="{Binding IsCreating}" Stroke="{DynamicResource OrielPaperBrush}" />
                                        <TextBlock Text="Create" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Panel>
                </Border>
                <!--  I'm feeling lucky: an idea and a look at random, made right away  -->
                <Button Grid.Column="1" Height="56" Padding="20,0" CornerRadius="28" VerticalAlignment="Center" VerticalContentAlignment="Center"
                        Background="{DynamicResource OrielSurfaceBrush}" Command="{Binding LuckyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Width="18" Height="18">
                                <Panel Width="24" Height="24">
                                    <Path Data="M5,3H19A2,2 0 0 1 21,5V19A2,2 0 0 1 19,21H5A2,2 0 0 1 3,19V5A2,2 0 0 1 5,3Z" Stroke="{DynamicResource OrielInkBrush}" StrokeThickness="1.75" />
                                    <Path Data="M8,6.5A1.5,1.5 0 1 1 8,9.5A1.5,1.5 0 1 1 8,6.5ZM16,6.5A1.5,1.5 0 1 1 16,9.5A1.5,1.5 0 1 1 16,6.5ZM12,10.5A1.5,1.5 0 1 1 12,13.5A1.5,1.5 0 1 1 12,10.5ZM8,14.5A1.5,1.5 0 1 1 8,17.5A1.5,1.5 0 1 1 8,14.5ZM16,14.5A1.5,1.5 0 1 1 16,17.5A1.5,1.5 0 1 1 16,14.5Z" Fill="{DynamicResource OrielInkBrush}" />
                                </Panel>
                            </Viewbox>
                        <TextBlock VerticalAlignment="Center" Text="I'm feeling lucky" />
                    </StackPanel>
                </Button>
                </Grid>

                <!--  Looks: one is on  -->
                <ItemsControl ItemsSource="{Binding Styles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CreateStyleViewModel">
                            <ToggleButton Classes="chip" Margin="0,0,6,6" FontSize="13" Padding="12,4" Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <views:InfoBanner DataContext="{Binding Info}" />

                <!--  The canvas: ideas, the picture being made, or the picture  -->
                <Border Height="430" Background="{DynamicResource OrielSurfaceBrush}" CornerRadius="20" ClipToBounds="True">
                    <Panel>
                        <!--  Being made  -->
                        <Panel IsVisible="{Binding IsCreating}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <PathIcon Classes="twinkle" Data="{StaticResource Sparkles}" Width="34" Height="34" Foreground="{StaticResource AiTextGradient}">
                                    <PathIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <RotateTransform />
                                        </TransformGroup>
                                    </PathIcon.RenderTransform>
                                </PathIcon>
                                <TransitioningContentControl HorizontalAlignment="Center" FontWeight="SemiBold" Content="{Binding CreatingText}"
                                                             PageTransition="{StaticResource WordsSlide}" />
                            </StackPanel>
                        </Panel>

                        <!--  The picture, with its actions on it  -->
                        <Panel IsVisible="{Binding ShowPicture}">
                            <Image controls:ImageReveal.Enabled="True" Source="{Binding Picture}" Stretch="UniformToFill" />
                            <Border VerticalAlignment="Bottom" Padding="18,48,12,12" Background="{StaticResource OrielPhotoScrimBrush}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" MaxLines="1"
                                               TextTrimming="CharacterEllipsis" Text="{Binding PictureCaption}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="onphoto-pill" FontSize="13" Command="{Binding SetCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Arc Classes="spinner" Classes.busy="{Binding IsSetting}" Width="12" Height="12" Stroke="#141414" />
                                                <TransitioningContentControl VerticalAlignment="Center" Content="{Binding SetText}"
                                                                             PageTransition="{StaticResource WordsSlide}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Panel>

                        <!--  Nothing yet: ideas to start from; picking one fills in the words  -->
                        <StackPanel MaxWidth="640" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                    IsVisible="{Binding ShowIdeas}">
                            <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding Ideas}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Margin="4" Padding="14,7" FontSize="13" Background="{DynamicResource OrielPaperBrush}" Content="{Binding}"
                                                Command="{Binding $parent[ItemsControl].((vm:CreateViewModel)DataContext).UseIdeaCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Center" Command="{Binding ShuffleIdeasCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" />
                                    <TextBlock VerticalAlignment="Center" Text="Shuffle" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Panel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
