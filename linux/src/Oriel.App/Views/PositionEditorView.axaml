<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oriel.UI.ViewModels"
             x:Class="Oriel.UI.Views.PositionEditorView"
             x:DataType="vm:PositionEditorViewModel">
    <!--  Over the whole window: the photo, whole, with this screen's shape over it (PositionEditorView.axaml.cs).  -->
    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto" Margin="0" Background="{DynamicResource OrielPaperBrush}">
        <Grid Margin="32,20,32,0">
            <TextBlock Classes="title" VerticalAlignment="Center" Text="Position" />
            <Button Classes="icon" HorizontalAlignment="Right" Click="Close_Click" ToolTip.Tip="Close (Esc)">
                <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
            </Button>
        </Grid>

        <Panel x:Name="Stage" Grid.Row="1" Margin="32,20">
            <Canvas x:Name="Board" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                    IsVisible="{Binding IsReady}">
                <Image x:Name="Whole" Source="{Binding Whole}" Stretch="Fill" />
                <!--  The rest of the photo, dimmed around the window.  -->
                <Path x:Name="Dim" Fill="#99000000" />
                <!--  The window: this screen's shape, with the thirds while dragging.  -->
                <Border x:Name="WindowFrame" BorderBrush="White" BorderThickness="2">
                    <Grid x:Name="Thirds" Opacity="0" ColumnDefinitions="*,*,*" RowDefinitions="*,*,*">
                        <Rectangle Grid.RowSpan="3" Width="1" HorizontalAlignment="Right" Fill="#73FFFFFF" />
                        <Rectangle Grid.Column="1" Grid.RowSpan="3" Width="1" HorizontalAlignment="Right" Fill="#73FFFFFF" />
                        <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="#73FFFFFF" />
                        <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="#73FFFFFF" />
                    </Grid>
                </Border>
            </Canvas>
            <Arc Classes="spinner busy" Width="32" Height="32" Stroke="{DynamicResource OrielInkBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
            <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{Binding Error}" IsVisible="{Binding HasError}" />
        </Panel>

        <StackPanel Grid.Row="2" Margin="0,0,0,28" HorizontalAlignment="Center" Spacing="16">
            <!--  Smart, Center, or where you put it: the same switch as History's, its pill sliding over.  -->
            <Border HorizontalAlignment="Center" Padding="3" CornerRadius="{DynamicResource OrielPill}" BorderThickness="1"
                    IsHitTestVisible="{Binding CanEditNow}"
                    BorderBrush="{DynamicResource OrielLineBrush}" Background="{DynamicResource OrielSurfaceBrush}">
                <Panel>
                    <Border x:Name="ModeIndicator" Width="96" HorizontalAlignment="Left" CornerRadius="{DynamicResource OrielTabItem}"
                            Background="{DynamicResource OrielInkBrush}">
                        <Border.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="0.05,0.7,0.1,1" />
                            </Transitions>
                        </Border.Transitions>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Classes="seg" Width="96" Height="30" CornerRadius="{DynamicResource OrielTabItem}"
                                      IsChecked="{Binding IsSmart}" ToolTip.Tip="Unsplash finds the faces or the detail">
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="Smart" />
                        </ToggleButton>
                        <ToggleButton Classes="seg" Width="96" Height="30" CornerRadius="{DynamicResource OrielTabItem}"
                                      IsChecked="{Binding IsCenter}">
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="Center" />
                        </ToggleButton>
                        <ToggleButton Classes="seg" Width="96" Height="30" CornerRadius="{DynamicResource OrielTabItem}"
                                      IsChecked="{Binding IsCustom}" ToolTip.Tip="Drag the frame, or click where it goes">
                            <TextBlock VerticalAlignment="Center" FontSize="13" Text="Custom" />
                        </ToggleButton>
                    </StackPanel>
                </Panel>
            </Border>
            <Button Classes="primary" MinWidth="200" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                    Click="Set_Click" IsEnabled="{Binding CanEditNow}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Arc Classes="spinner" Classes.busy="{Binding IsBusy}" Stroke="{DynamicResource OrielPaperBrush}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding ButtonText}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
