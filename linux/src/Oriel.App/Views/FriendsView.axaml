<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oriel.UI.ViewModels"
             x:Class="Oriel.UI.Views.FriendsView"
             x:DataType="vm:FriendsViewModel">
    <ScrollViewer>
        <StackPanel MaxWidth="960" Margin="40,8,40,40" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="Friends" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Share your wallpaper, or show a friend's on your desktop. It follows every change." />
            </StackPanel>

            <!--  ============ Share your wallpaper ============  -->
            <Border Padding="24" CornerRadius="20" Background="{DynamicResource OrielSurfaceBrush}">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource OrielPaperBrush}">
                            <PathIcon Data="{StaticResource IconShare}" Width="18" Height="18" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Share your wallpaper" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Friends with your code see the wallpaper on your desktop, every time it changes." />
                        </StackPanel>
                    </Grid>

                    <Button Classes="primary" HorizontalAlignment="Left" Content="Create my code" Command="{Binding StartSharingCommand}"
                            IsVisible="{Binding IsNotSharing}" />

                    <Border Padding="20,16" CornerRadius="16" Background="{DynamicResource OrielPaperBrush}" IsVisible="{Binding IsSharing}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <SelectableTextBlock FontFamily="monospace" FontSize="30" FontWeight="SemiBold" LetterSpacing="3" Text="{Binding MyCode}" />
                                <TextBlock Classes="muted small" Text="{Binding FollowersText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary" Click="CopyCode_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Panel>
                                            <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" IsVisible="{Binding !IsCopied}" />
                                            <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" IsVisible="{Binding IsCopied}" />
                                        </Panel>
                                        <TextBlock VerticalAlignment="Center" Text="Copy" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Stop sharing" Command="{Binding StopSharingCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border CornerRadius="12" Padding="16,10" Background="#33E0A100" IsVisible="{Binding HasSharingError}">
                        <TextBlock Text="{Binding SharingError}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!--  ============ Follow a friend ============  -->
            <Border Padding="24" CornerRadius="20" Background="{DynamicResource OrielSurfaceBrush}">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource OrielPaperBrush}">
                            <PathIcon Data="{StaticResource IconPeople}" Width="18" Height="18" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Follow a friend" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="Enter their code and your desktop shows their wallpaper. Your own schedule pauses until you unfollow." />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsNotFollowing}">
                        <TextBox Height="40" FontFamily="monospace" FontSize="16" MaxLength="9" PlaceholderText="K7MQ-2XPA" Text="{Binding CodeInput}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding FollowCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Classes="primary" MinWidth="110" HorizontalContentAlignment="Center" Content="Follow"
                                Command="{Binding FollowCommand}" />
                    </Grid>

                    <Border Padding="16" CornerRadius="16" Background="{DynamicResource OrielPaperBrush}" IsVisible="{Binding IsFollowing}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource OrielInkBrush}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OrielPaperBrush}" Text="{Binding FollowingInitial}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding FollowingName, StringFormat='Following {0}'}" />
                                <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Your desktop shows their wallpaper as it changes." />
                            </StackPanel>
                            <Button Grid.Column="2" VerticalAlignment="Center" Content="Unfollow" Command="{Binding UnfollowCommand}" />
                        </Grid>
                    </Border>

                    <Border CornerRadius="12" Padding="16,10" Background="#33E0A100" IsVisible="{Binding HasFollowError}">
                        <TextBlock Text="{Binding FollowError}" TextWrapping="Wrap" />
                    </Border>
                    <Border CornerRadius="12" Padding="16,10" Background="{DynamicResource OrielPaperBrush}" IsVisible="{Binding HasFollowProblem}">
                        <TextBlock Text="{Binding FollowProblem}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!--  ============ How it works ============  -->
            <TextBlock Classes="section" Margin="2,8,0,0" Text="How it works" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Padding="18" CornerRadius="16" Background="{DynamicResource OrielSurfaceBrush}">
                    <StackPanel Spacing="10">
                        <Border Width="28" Height="28" HorizontalAlignment="Left" CornerRadius="14" Background="{DynamicResource OrielInkBrush}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OrielPaperBrush}" Text="1" />
                        </Border>
                        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Create your code here." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="18" CornerRadius="16" Background="{DynamicResource OrielSurfaceBrush}">
                    <StackPanel Spacing="10">
                        <Border Width="28" Height="28" HorizontalAlignment="Left" CornerRadius="14" Background="{DynamicResource OrielInkBrush}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OrielPaperBrush}" Text="2" />
                        </Border>
                        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Send it to a friend who has Oriel." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="18" CornerRadius="16" Background="{DynamicResource OrielSurfaceBrush}">
                    <StackPanel Spacing="10">
                        <Border Width="28" Height="28" HorizontalAlignment="Left" CornerRadius="14" Background="{DynamicResource OrielInkBrush}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OrielPaperBrush}" Text="3" />
                        </Border>
                        <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Their desktop follows yours. Stop sharing any time." />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
