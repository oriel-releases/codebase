<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oriel.UI.ViewModels"
             xmlns:views="using:Oriel.UI.Views"
             x:Class="Oriel.UI.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <ScrollViewer>
        <StackPanel MaxWidth="960" Margin="40,8,40,40">
            <Grid>
                <TextBlock Classes="title" Text="{Binding Title}" />
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <!--  "Set again": what it's doing now, the same words as on Home and Search.  -->
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Stage}" IsVisible="{Binding IsChanging}" />
                <!--  Grid or list, like the phone's segmented control: a soft track, and an ink pill sliding to the pick.  -->
                <Border VerticalAlignment="Center" Padding="3" CornerRadius="{DynamicResource OrielPill}" BorderThickness="1"
                        BorderBrush="{DynamicResource OrielLineBrush}" Background="{DynamicResource OrielSurfaceBrush}">
                    <Panel>
                        <Border x:Name="ViewIndicator" Width="78" HorizontalAlignment="Left" CornerRadius="{DynamicResource OrielTabItem}" Background="{DynamicResource OrielInkBrush}">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="0.05,0.7,0.1,1" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Classes="seg" Width="78" Height="30" CornerRadius="{DynamicResource OrielTabItem}" IsChecked="{Binding IsGrid}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource IconGrid}" Width="12" Height="12" />
                                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="Grid" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Classes="seg" Width="78" Height="30" CornerRadius="{DynamicResource OrielTabItem}" IsChecked="{Binding IsList}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{StaticResource IconList}" Width="12" Height="12" />
                                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="List" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Panel>
                </Border>
                </StackPanel>
            </Grid>

            <views:InfoBanner Margin="0,0,0,12" DataContext="{Binding Info}" />

            <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center" Spacing="12" IsVisible="{Binding IsEmpty}">
                <Image Width="48" Height="48" Opacity="0.25" Source="{DynamicResource OrielLogo}" />
                <TextBlock Classes="muted" HorizontalAlignment="Center" Text="{Binding EmptyText}" />
            </StackPanel>

            <!--  Virtualized: only the cards on screen exist, so a long history stays cheap  -->
            <ItemsRepeater ItemsSource="{Binding Items}" IsVisible="{Binding IsGrid}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="12" MinItemWidth="300" MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <views:HistoryCard />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <ItemsRepeater ItemsSource="{Binding Items}" IsVisible="{Binding IsList}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                        <views:HistoryRow />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</UserControl>
