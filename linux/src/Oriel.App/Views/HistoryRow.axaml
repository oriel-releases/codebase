<views:HistoryItemControl xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:vm="using:Oriel.UI.ViewModels"
                          xmlns:views="using:Oriel.UI.Views"
                          xmlns:controls="using:Oriel.UI.Controls"
                          x:Class="Oriel.UI.Views.HistoryRow"
                          x:DataType="vm:HistoryItemViewModel">
    <!--  A row: its thumbnail, the photographer and one line; a click opens the photo on its own page.  -->
    <Border Padding="8" Background="{DynamicResource OrielSurfaceBrush}" CornerRadius="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border x:Name="Thumb" Width="112" Height="64" Background="{DynamicResource OrielLineBrush}" CornerRadius="8" ClipToBounds="True">
                <Image controls:ImageReveal.Enabled="True" Source="{Binding Preview}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding PhotographerName}" />
                <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
            </StackPanel>
            <PathIcon Grid.Column="2" Margin="0,0,8,0" Width="14" Height="14" Data="{StaticResource IconStarFilled}"
                      Foreground="{StaticResource OrielStarBrush}" IsVisible="{Binding IsFavorite}" />
        </Grid>
    </Border>
</views:HistoryItemControl>
