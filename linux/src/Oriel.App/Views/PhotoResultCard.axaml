<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Oriel.UI.ViewModels"
             xmlns:controls="using:Oriel.UI.Controls"
             x:Class="Oriel.UI.Views.PhotoResultCard"
             x:DataType="vm:PhotoResultViewModel">
    <!--  The same card as History's; a click opens the photo on its own page, with its actions.  -->
    <Border Height="210" Background="{DynamicResource OrielLineBrush}" CornerRadius="{DynamicResource OrielCard}" ClipToBounds="True">
        <Grid>
            <Image controls:ImageReveal.Enabled="True" Source="{Binding Preview}" Stretch="UniformToFill" />
            <PathIcon Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" Width="16" Height="16"
                      Data="{StaticResource IconStarFilled}" Foreground="{StaticResource OrielStarBrush}"
                      IsVisible="{Binding IsFavorite}" />
            <!--  The fade keeps the white text readable on any photo.  -->
            <StackPanel VerticalAlignment="Bottom" Background="{StaticResource OrielPhotoScrimBrush}">
                <StackPanel Margin="14,44,14,12">
                    <TextBlock FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Text="{Binding PhotographerName}" />
                    <TextBlock FontSize="12" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
