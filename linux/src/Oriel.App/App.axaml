<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Oriel.UI.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Oriel/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Light and dark follow the desktop. Accent is ink, as on the website.  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="OrielPaper">#FAFAFA</Color>
                    <Color x:Key="OrielSurface">#F1F1F1</Color>
                    <Color x:Key="OrielLine">#E4E4E4</Color>
                    <Color x:Key="OrielMuted">#6B6B6B</Color>
                    <Color x:Key="OrielInk">#141414</Color>
                    <Color x:Key="OrielInkHover">#363636</Color>
                    <SolidColorBrush x:Key="OrielPaperBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="OrielSurfaceBrush" Color="#F1F1F1" />
                    <SolidColorBrush x:Key="OrielLineBrush" Color="#E4E4E4" />
                    <SolidColorBrush x:Key="OrielMutedBrush" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="OrielInkBrush" Color="#141414" />
                    <SolidColorBrush x:Key="OrielInkHoverBrush" Color="#363636" />
                    <Color x:Key="SystemAccentColor">#141414</Color>
                    <Color x:Key="SystemAccentColorLight1">#363636</Color>
                    <Color x:Key="SystemAccentColorLight2">#363636</Color>
                    <Color x:Key="SystemAccentColorLight3">#363636</Color>
                    <Color x:Key="SystemAccentColorDark1">#141414</Color>
                    <Color x:Key="SystemAccentColorDark2">#141414</Color>
                    <Color x:Key="SystemAccentColorDark3">#141414</Color>
                    <Bitmap x:Key="OrielLogo">avares://Oriel/Assets/Logo.png</Bitmap>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="OrielPaper">#0F0F0F</Color>
                    <Color x:Key="OrielSurface">#1A1A1A</Color>
                    <Color x:Key="OrielLine">#262626</Color>
                    <Color x:Key="OrielMuted">#9A9A9A</Color>
                    <Color x:Key="OrielInk">#F2F2F2</Color>
                    <Color x:Key="OrielInkHover">#D6D6D6</Color>
                    <SolidColorBrush x:Key="OrielPaperBrush" Color="#0F0F0F" />
                    <SolidColorBrush x:Key="OrielSurfaceBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="OrielLineBrush" Color="#262626" />
                    <SolidColorBrush x:Key="OrielMutedBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="OrielInkBrush" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="OrielInkHoverBrush" Color="#D6D6D6" />
                    <Color x:Key="SystemAccentColor">#F2F2F2</Color>
                    <Color x:Key="SystemAccentColorLight1">#D6D6D6</Color>
                    <Color x:Key="SystemAccentColorLight2">#D6D6D6</Color>
                    <Color x:Key="SystemAccentColorLight3">#D6D6D6</Color>
                    <Color x:Key="SystemAccentColorDark1">#F2F2F2</Color>
                    <Color x:Key="SystemAccentColorDark2">#F2F2F2</Color>
                    <Color x:Key="SystemAccentColorDark3">#F2F2F2</Color>
                    <Bitmap x:Key="OrielLogo">avares://Oriel/Assets/Logo-Dark.png</Bitmap>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Oriel/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
