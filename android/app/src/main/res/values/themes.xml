<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window before Compose draws: same paper color, so starting up doesn't flash. -->
    <style name="Theme.Oriel" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
