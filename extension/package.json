{
  "name": "oriel-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode chrome",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "pool": "node scripts/build-pool.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/chrome": "^0.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7"
  }
}
